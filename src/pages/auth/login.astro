---
import Layout from '~/layouts/Layout.astro';
import Toast from '~/components/Toast.astro';
---

<Layout title="Login - Dashboard Projek">
  <div class="flex-1 w-full min-h-screen flex items-center justify-center p-4 sm:p-6 bg-slate-50 dark:bg-slate-950 transition-colors duration-200">
    <!-- Main Auth Card -->
    <div class="relative w-full max-w-md bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 space-y-6 text-slate-800 dark:text-slate-100 rounded-2xl shadow-sm transition-all">
      
      <!-- Top Theme Switcher & Header -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-sm">
            <i class="fa-solid fa-square-check text-lg"></i>
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white text-base tracking-tight block leading-tight">ProjekApp</span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Management Platform</span>
          </div>
        </div>
        <button
          type="button"
          onclick="toggleTheme()"
          title="Ubah Tema"
          class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/60 dark:border-slate-800 transition-colors"
        >
          <i class="fa-solid fa-moon dark:hidden text-xs"></i>
          <i class="fa-solid fa-sun hidden dark:block text-xs text-amber-400"></i>
        </button>
      </div>

      <div class="space-y-1">
        <h1 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Masuk ke Akun</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">Masukkan kredensial Anda untuk melanjutkan ke dashboard</p>
      </div>

      <form id="loginForm" class="space-y-4">
        <div class="space-y-3">
          <div>
            <label for="email" class="block mb-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300">Alamat Email</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="fa-regular fa-envelope text-xs"></i>
              </div>
              <input
                type="email"
                name="email"
                id="email"
                placeholder="nama@email.com"
                class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-xs sm:text-sm rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-500"
                required
              />
            </div>
          </div>
          <div>
            <label for="password" class="block mb-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300">Kata Sandi</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="fa-solid fa-lock text-xs"></i>
              </div>
              <input
                type="password"
                name="password"
                id="password"
                placeholder="••••••••"
                class="w-full pl-9 pr-10 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-xs sm:text-sm rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-500"
                required
              />
              <button
                type="button"
                onclick="togglePasswordVisibility('password', 'togglePasswordIcon')"
                title="Lihat / Sembunyikan Kata Sandi"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
              >
                <i id="togglePasswordIcon" class="fa-regular fa-eye text-xs"></i>
              </button>
            </div>
          </div>
        </div>

        <button
          type="submit"
          id="submitBtn"
          class="w-full py-2.5 px-4 mt-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-brand-500/20 focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Masuk</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      </form>

      <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 text-center">
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Belum punya akun?{' '}
          <a href="/auth/register" class="font-semibold text-brand-600 dark:text-brand-400 hover:underline">
            Daftar di sini
          </a>
        </p>
      </div>
    </div>
  </div>

  <Toast />

  <script is:inline>
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    function togglePasswordVisibility(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (!input || !icon) return;

      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fa-regular fa-eye-slash text-xs text-brand-600 dark:text-brand-400';
      } else {
        input.type = 'password';
        icon.className = 'fa-regular fa-eye text-xs';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('registered') && window.Ghostoast) {
        Ghostoast.success('Akun Anda berhasil dibuat! Silakan masuk.', 'Registrasi Sukses');
      }
    });

    document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submitBtn');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Memverifikasi...';
      }

      if (window.showLoadingScreen) {
        window.showLoadingScreen('Memverifikasi Akun', 'Sedang memverifikasi data login Anda...');
      }

      try {
        const formData = new FormData(e.target);
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          body: formData,
        });
        let data = {};
        const contentType = res.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
          data = await res.json();
        } else {
          const text = await res.text();
          throw new Error(text || 'Terjadi kesalahan pada server.');
        }
        
        if (!res.ok) {
          throw new Error(data.error || 'Kredensial login tidak valid.');
        }

        if (window.updateLoadingText) {
          window.updateLoadingText('Login Berhasil', 'Mengalihkan ke dashboard...');
        }

        if (window.Ghostoast) {
          Ghostoast.success('Login berhasil! Mengalihkan ke dashboard...', 'Selamat Datang');
        }

        setTimeout(() => {
          window.location.href = '/?login=success';
        }, 800);
      } catch (err) {
        if (window.hideLoadingScreen) {
          window.hideLoadingScreen();
        }
        if (window.Ghostoast) {
          Ghostoast.error(err.message, 'Gagal Login');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Masuk</span> <i class="fa-solid fa-arrow-right text-xs"></i>';
        }
      }
    });
  </script>
</Layout>
