    function openSubTaskModal(parentId, parentTitle, event) {
      if (event) event.stopPropagation();
      const parentInput = document.getElementById("taskParentId");
      const parentBanner = document.getElementById("parentTaskBanner");
      const parentTitleName = document.getElementById("parentTaskTitleName");
      const modalTitle = document.getElementById("taskModalTitle");
      const subTaskSection = document.getElementById("subTaskFormSection");

      if (parentInput) parentInput.value = parentId;
      if (parentTitleName) parentTitleName.innerText = parentTitle;
      if (parentBanner) {
        parentBanner.classList.remove("hidden");
        parentBanner.classList.add("flex");
      }
      if (modalTitle) {
        const titleSpan = modalTitle.querySelector("span");
        if (titleSpan) titleSpan.innerText = "Tambah Sub-Task Baru";
      }
      if (subTaskSection) {
        subTaskSection.classList.add("hidden");
      }

      clearSubTaskRows();
      openModal("taskModal");
    }

    function clearTaskParentId() {
      const parentInput = document.getElementById("taskParentId");
      const parentBanner = document.getElementById("parentTaskBanner");
      const modalTitle = document.getElementById("taskModalTitle");
      const subTaskSection = document.getElementById("subTaskFormSection");

      if (parentInput) parentInput.value = "";
      if (parentBanner) {
        parentBanner.classList.add("hidden");
        parentBanner.classList.remove("flex");
      }
      if (modalTitle) {
        const titleSpan = modalTitle.querySelector("span");
        if (titleSpan) titleSpan.innerText = "Tambah Task / Pekerjaan Baru";
      }
      if (subTaskSection) {
        subTaskSection.classList.remove("hidden");
      }
      clearSubTaskRows();
    }

    function toggleExpandTask(taskId, event) {
      if (event) event.stopPropagation();
      if (expandedTaskIds.has(taskId)) {
        expandedTaskIds.delete(taskId);
      } else {
        expandedTaskIds.add(taskId);
      }
      renderDashboard();
    }

    function buildTaskTree(allTasks) {
      const map = {};
      const roots = [];

      (allTasks || []).forEach((task) => {
        map[task.id] = { ...task, children: [] };
      });

      (allTasks || []).forEach((task) => {
        if (task.parentId && map[task.parentId]) {
          map[task.parentId].children.push(map[task.id]);
        } else {
          roots.push(map[task.id]);
        }
      });

      return roots;
    }

    function filterTaskTree(nodes, filterMode, query) {
      const result = [];

      (nodes || []).forEach((node) => {
        const filteredChildren = filterTaskTree(node.children || [], filterMode, query);
        
        let matchesSelf = true;
        if (filterMode === "active" && node.completed) matchesSelf = false;
        if (filterMode === "completed" && !node.completed) matchesSelf = false;
        if (query) {
          const q = query.toLowerCase();
          const matchTitle = (node.title || "").toLowerCase().includes(q);
          const matchDesc = (node.description || "").toLowerCase().includes(q);
          if (!matchTitle && !matchDesc) matchesSelf = false;
        }

        if (matchesSelf || filteredChildren.length > 0) {
          if (filteredChildren.length > 0 && query) {
            expandedTaskIds.add(node.id);
          }
          result.push({
            ...node,
            children: filteredChildren,
          });
        }
      });

      return result;
    }

