      currentDeployedFilter = filter;
      document.querySelectorAll(".deployed-filter-btn").forEach(btn => {
        btn.classList.remove("bg-brand-600", "text-white", "font-semibold");
        btn.classList.add("text-slate-600", "dark:text-slate-400", "font-medium");
      });
      const activeBtn = document.getElementById(`deployedFilter-${filter}`);
      if (activeBtn) {
        activeBtn.classList.add("bg-brand-600", "text-white", "font-semibold");
        activeBtn.classList.remove("text-slate-600", "dark:text-slate-400", "font-medium");
      }
      renderDeployedTable();
    }

    function formatDate(dateStr) {
      if (!dateStr) return "-";
      try {
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return "-";
        return d.toLocaleDateString("id-ID", {
          day: "numeric",
          month: "short",
          year: "numeric"
        });
      } catch (e) {
        return "-";
      }
    }

