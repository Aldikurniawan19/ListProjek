---
---
<div
  id="detailView"
  class="task-detail-view flex-col flex-1 min-h-0 space-y-4 overflow-hidden"
  style="display: none;"
>
  <div
    class="flex flex-row items-center justify-between gap-2.5 bg-white dark:bg-slate-900 p-2.5 sm:p-3 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm shrink-0 transition-colors duration-200"
  >
    <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 min-w-0 flex-1">
      <button
        onclick="showDashboardView()"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/60 hover:bg-brand-100 dark:hover:bg-brand-900/80 border border-brand-200/60 dark:border-brand-800/60 transition-all shrink-0 cursor-pointer"
        title="Kembali ke Daftar Projek"
      >
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        <span>Projek</span>
      </button>
      <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 shrink-0"></i>
      <span
        id="breadcrumbProjectTitle"
        class="font-bold text-slate-800 dark:text-slate-200 text-xs sm:text-sm truncate min-w-0 flex-1"
      >
        Nama Projek
      </span>
    </div>
    <div class="flex items-center gap-2 shrink-0 ml-auto">
      <button
        onclick="deleteActiveProject()"
        class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 transition-all border border-rose-100 dark:border-rose-900/50 flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
        title="Hapus Projek Ini"
      >
        <i class="fa-regular fa-trash-can text-xs"></i>
        <span class="hidden xs:inline">Hapus Projek</span>
      </button>
    </div>
  </div>

  <div
    class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden p-4 sm:p-6 shrink-0 transition-colors duration-200"
  >
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
      <div class="flex-1">
        <div class="flex items-start justify-between">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2
                id="detailProjectTitle"
                class="text-base sm:text-xl font-bold text-slate-900 dark:text-white"
              >
                Loading...
              </h2>
              <span
                id="detailProjectStatus"
                class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 whitespace-nowrap"
              >
                ...
              </span>
            </div>
            <p
              id="detailProjectCategory"
              class="text-xs font-bold text-brand-600 dark:text-brand-400 mt-1"
            >
              ...
            </p>
          </div>
        </div>
        <p
          id="detailProjectDesc"
          class="text-xs text-slate-600 dark:text-slate-300 mt-3 leading-relaxed"
        >
          ...
        </p>

        <!-- Live Website URL & Visitor Analytics Monitoring -->
        <div id="detailLiveUrlContainer" class="mt-4 hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center justify-center text-sm shrink-0">
                <i class="fa-solid fa-globe"></i>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Live URL Website</span>
                  <span id="detailLiveStatusBadge" class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Deployed / Online
                  </span>
                </div>
                <a
                  id="detailLiveUrlLink"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline truncate block"
                >
                  https://...
                </a>
              </div>
            </div>
            
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 shadow-xs flex items-center gap-1.5">
                <i class="fa-solid fa-chart-line text-brand-500 text-[11px]"></i>
                <span id="visitorCountText">0</span> Akses Hari Ini
              </span>
              <a
                id="detailVisitBtn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-700 active:scale-95 text-white text-xs font-semibold shadow-xs flex items-center gap-1.5 transition-all"
              >
                <span>Kunjungi Web</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="w-full sm:w-56 space-y-3">
        <div class="space-y-1">
          <div class="flex justify-between items-center">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300"
              >Progres Projek</span
            >
            <span
              id="detailProgressText"
              class="text-xs font-bold text-brand-700 dark:text-brand-400"
            >
              0%
            </span>
          </div>
          <div
            class="w-full bg-slate-100 dark:bg-slate-800 h-3 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700"
          >
            <div
              id="detailProgressBar"
              class="bg-emerald-500 h-full rounded-full transition-all duration-300"
              style="width: 0%"
            >
            </div>
          </div>
        </div>
        <p
          id="detailTaskCountLabel"
          class="text-[11px] text-slate-500 dark:text-slate-400 font-medium text-center"
        >
          Memuat task...
        </p>
      </div>
    </div>
  </div>

  <div
    class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden flex-1 min-h-0 flex flex-col transition-colors duration-200"
  >
    <div
      class="p-2.5 sm:p-4 border-b border-slate-200/80 dark:border-slate-800 flex flex-row items-center justify-between gap-2 shrink-0"
    >
      <div
        class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar flex-1 min-w-0 pr-1"
      >
        <button
          id="taskFilter-all"
          onclick="setTaskFilter('all')"
          class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-all bg-brand-600 text-white whitespace-nowrap cursor-pointer shrink-0"
        >
          Semua
        </button>
        <button
          id="taskFilter-active"
          onclick="setTaskFilter('active')"
          class="px-2.5 py-1 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-all whitespace-nowrap cursor-pointer shrink-0"
        >
          Belum Selesai
        </button>
        <button
          id="taskFilter-completed"
          onclick="setTaskFilter('completed')"
          class="px-2.5 py-1 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-all whitespace-nowrap cursor-pointer shrink-0"
        >
          Selesai
        </button>
      </div>
      <button
        type="button"
        onclick="openModal('taskModal')"
        class="px-2.5 py-1.5 sm:px-4 sm:py-2 bg-brand-600 hover:bg-brand-700 active:scale-95 text-white rounded-xl text-xs font-bold shadow-md shadow-brand-500/20 transition-all flex items-center gap-1 sm:gap-1.5 shrink-0 ml-auto whitespace-nowrap cursor-pointer"
      >
        <i class="fa-solid fa-plus text-xs"></i>
        <span><span class="hidden sm:inline">Tambah </span>Task<span class="hidden xs:inline sm:inline"> Baru</span></span>
      </button>
    </div>

    <div
      id="tasksListContainer"
      class="overflow-y-auto flex-1 min-h-0 divide-y divide-slate-100 dark:divide-slate-800"
    >
    </div>

    <div
      id="tasksEmptyState"
      class="hidden flex-col items-center justify-center p-12 text-center"
    >
      <div
        class="w-14 h-14 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xl mb-3"
      >
        <i class="fa-solid fa-list-check"></i>
      </div>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">
        Belum Ada Task
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs">
        Mulai tambahkan pekerjaan atau sub-task untuk projek ini.
      </p>
      <button
        onclick="openModal('taskModal')"
        class="mt-4 bg-brand-600 text-white px-4 py-2 rounded-lg text-xs font-semibold"
      >
        + Tambah Task Baru
      </button>
    </div>
  </div>
</div>
