---
---
<div
  id="taskModal"
  class="fixed inset-0 bg-slate-950/70 z-50 flex items-center justify-center p-4 hidden backdrop-blur-md modal"
>
  <div
    class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-lg overflow-hidden modal-content flex flex-col"
  >
    <!-- Mobile Drag Handle Bar -->
    <div class="w-12 h-1.5 bg-slate-300 dark:bg-slate-700 rounded-full mx-auto my-2 sm:hidden shrink-0"></div>

    <div
      class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/80 dark:bg-slate-800/80"
    >
      <h3 id="taskModalTitle" class="font-bold text-slate-900 dark:text-white text-sm flex items-center gap-2">
        <i class="fa-solid fa-list-check text-brand-600 dark:text-brand-400"></i>
        <span>Tambah Task / Pekerjaan Baru</span>
      </h3>
      <button
        onclick="closeModal('taskModal')"
        class="text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-white text-sm"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form id="taskForm" onsubmit="saveTask(event)" class="p-6 space-y-4">
      <input type="hidden" id="taskParentId" value="" />
      
      <!-- Parent Task Info Banner (Shown when creating sub-task) -->
      <div id="parentTaskBanner" class="hidden items-center justify-between p-2.5 bg-brand-50 dark:bg-brand-950/50 border border-brand-200 dark:border-brand-800/60 rounded-xl text-xs text-brand-700 dark:text-brand-300">
        <div class="flex items-center gap-2 truncate">
          <i class="fa-solid fa-sitemap text-brand-500"></i>
          <span class="font-medium">Sub-task untuk: <strong id="parentTaskTitleName" class="font-bold">...</strong></span>
        </div>
        <button
          type="button"
          onclick="clearTaskParentId()"
          class="text-brand-500 hover:text-rose-600 dark:hover:text-rose-400 p-1 rounded transition-colors shrink-0"
          title="Batal pilih parent"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1"
          >Nama / Judul Task <span class="text-rose-500">*</span></label
        >
        <input
          type="text"
          id="taskTitle"
          required
          placeholder="Contoh: Membuat menu dashboard"
          class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white dark:focus:bg-slate-800 transition-all"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1"
          >Deskripsi Detail Task</label
        >
        <textarea
          id="taskDesc"
          rows="3"
          placeholder="Contoh: Nantinya menu akan menampilkan grafik penjualan, total transaksi bulanan, serta statistik performa harian..."
          class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white dark:focus:bg-slate-800 transition-all resize-none"
        ></textarea>
      </div>

      <!-- Interactive Sub-Task Section (Opsional) -->
      <div id="subTaskFormSection" class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <i class="fa-solid fa-sitemap text-brand-500 text-[11px]"></i>
            <span>Tambah Sub-Task Sekaligus</span>
            <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">(Opsional)</span>
          </label>
          <button
            type="button"
            onclick="addSubTaskRow()"
            class="px-2.5 py-1 text-[11px] font-semibold text-brand-600 dark:text-brand-400 bg-brand-50 hover:bg-brand-100 dark:bg-brand-950/60 dark:hover:bg-brand-900/80 rounded-lg border border-brand-200/60 dark:border-brand-800/60 flex items-center gap-1 transition-all cursor-pointer"
          >
            <i class="fa-solid fa-plus text-[10px]"></i>
            <span>Tambah Sub-Task</span>
          </button>
        </div>

        <div id="subTasksContainer" class="space-y-2 max-h-40 overflow-y-auto pr-1">
          <!-- Dynamic sub-task rows appended here -->
        </div>
      </div>
      <div
        class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800"
      >
        <button
          type="button"
          onclick="closeModal('taskModal')"
          class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all"
        >
          Batal
        </button>
        <button
          type="submit"
          class="px-4 py-2 rounded-lg text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white shadow-sm shadow-brand-500/20 transition-all"
        >
          Simpan Task
        </button>
      </div>
    </form>
  </div>
</div>
