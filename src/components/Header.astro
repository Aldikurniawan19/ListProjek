---
---
<header
  class="h-16 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-slate-800 px-4 md:px-8 flex items-center justify-between gap-4 shrink-0 z-10 transition-colors duration-200"
>
  <div class="flex items-center gap-3">
    <button
      onclick="toggleSidebar()"
      class="md:hidden p-2 text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg"
    >
      <i class="fa-solid fa-bars text-lg"></i>
    </button>
    <div class="flex items-center gap-2">
      <h2 id="viewTitle" class="text-lg font-bold text-slate-900 dark:text-white">
        Daftar Projek Utama
      </h2>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <!-- Theme Toggle Pill Switch (Left of Search Form) -->
    <button
      type="button"
      onclick="toggleTheme()"
      id="themeToggleBtn"
      class="relative w-14 h-7 rounded-full bg-slate-200 dark:bg-slate-800 p-1 transition-colors duration-300 focus:outline-none flex items-center cursor-pointer border border-slate-300/60 dark:border-slate-700 shadow-inner group shrink-0"
      title="Ganti Tema (Light/Dark)"
    >
      <!-- Background Icons -->
      <div class="w-full flex items-center justify-between px-1 text-[10px] select-none">
        <i class="fa-solid fa-sun text-amber-500 opacity-100 dark:opacity-40 transition-opacity"></i>
        <i class="fa-solid fa-moon text-indigo-400 opacity-40 dark:opacity-100 transition-opacity"></i>
      </div>
      <!-- Sliding Knob -->
      <div
        id="themeToggleKnob"
        class="absolute left-1 top-1 w-5 h-5 rounded-full bg-white dark:bg-slate-900 shadow-md transform transition-transform duration-300 ease-out flex items-center justify-center border border-slate-200 dark:border-slate-700"
      >
        <i id="themeToggleKnobIcon" class="fa-solid fa-sun text-[10px] text-amber-500 dark:text-amber-400"></i>
      </div>
    </button>

    <!-- Search Form -->
    <div class="relative w-48 sm:w-64">
      <i
        class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-xs"
      ></i>
      <input
        type="text"
        id="searchInput"
        oninput="handleSearch()"
        placeholder="Cari projek atau task..."
        class="w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white dark:focus:bg-slate-800 transition-all"
      />
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      <button
        id="addDeployedWebBtn"
        onclick="openModal('deployedWebModal')"
        class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-2 transition-all shadow-sm shadow-emerald-500/20 whitespace-nowrap cursor-pointer"
        title="Tambah Web Online / Live App"
      >
        <i class="fa-solid fa-globe"></i>
        <span>+ Web Online</span>
      </button>
      <button
        id="mainActionBtn"
        onclick="openModal('projectModal')"
        class="bg-brand-600 hover:bg-brand-700 text-white px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-2 transition-all shadow-sm shadow-brand-500/20 whitespace-nowrap cursor-pointer"
        title="Buat Projek Baru yang Akan Dikerjakan"
      >
        <i class="fa-solid fa-plus"></i>
        <span>Projek Baru</span>
      </button>
    </div>
  </div>
</header>
