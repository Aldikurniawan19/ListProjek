---
---
<div
  id="calendarView"
  class="task-detail-view flex-col flex-1 min-h-0 space-y-4 overflow-hidden"
  style="display: none;"
>
  <!-- Modern Calendar Header Banner -->
  <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute left-1/3 bottom-0 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="flex items-center gap-4 relative z-10">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white flex items-center justify-center text-xl font-bold shadow-lg shadow-brand-500/30 border border-white/20">
        <i class="fa-solid fa-calendar-alt"></i>
      </div>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <h3 class="text-base font-extrabold tracking-tight text-white">Kalender & Agenda Kerja</h3>
          <span id="eventCountBadge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-brand-500/20 text-brand-300 border border-brand-400/30 backdrop-blur-md">
            0 Acara
          </span>
        </div>
        <p class="text-xs text-slate-400 flex items-center gap-2 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block animate-ping"></span>
          Terhubung ke Database PostgreSQL (Prisma Live Sync)
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2.5 relative z-10 w-full sm:w-auto justify-end">
      <button
        type="button"
        onclick="openEventModal()"
        class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 active:scale-95 text-white rounded-2xl text-xs font-bold shadow-lg shadow-brand-600/30 border border-white/10 transition-all flex items-center justify-center gap-2 group"
      >
        <i class="fa-solid fa-plus text-xs group-hover:rotate-90 transition-transform duration-300"></i>
        <span>Tambah Acara Baru</span>
      </button>
    </div>
  </div>

  <!-- Calendar Container -->
  <div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/50 flex-1 min-h-0 flex flex-col overflow-auto relative">
    <div id="calendar" class="flex-1 min-h-[520px]"></div>
  </div>
</div>
