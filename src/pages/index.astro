---
import Layout from '~/layouts/Layout.astro';
import Sidebar from '~/components/Sidebar.astro';
import Header from '~/components/Header.astro';
import Stats from '~/components/Stats.astro';
import Dashboard from './dashboard/index.astro';
import ProjectDetail from './projects/detail.astro';
import Calendar from './calendar/index.astro';
import NewsPortal from './news/index.astro';
import BooksView from './books/index.astro';
import ProjectModal from '~/components/ProjectModal.astro';
import TaskModal from '~/components/TaskModal.astro';
import EventModal from '~/components/EventModal.astro';
import DeployedWebModal from '~/components/DeployedWebModal.astro';
import BookModal from '~/components/BookModal.astro';
import BookReaderModal from '~/components/BookReaderModal.astro';
import DeployedView from '~/components/DeployedView.astro';
import MobileBottomNav from '~/components/MobileBottomNav.astro';
import Toast from '~/components/Toast.astro';
import { supabase } from '~/lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

if (!accessToken || !refreshToken) {
  return Astro.redirect('/auth/login');
}

const { data, error } = await supabase.auth.setSession({
  refresh_token: refreshToken.value,
  access_token: accessToken.value,
});

if (error || !data.user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/auth/login');
}

const user = data.user;
---
<Layout>
  <Sidebar user={user} />
  <div class="flex-1 flex flex-col min-w-0 h-screen md:ml-64 overflow-hidden">
    <Header />
    <main
      id="mainContent"
      class="flex-1 p-3 sm:p-4 md:p-6 pb-24 md:pb-8 overflow-y-auto space-y-4"
    >
      <Stats />
      <Dashboard />
      <DeployedView />
      <ProjectDetail />
      <Calendar />
      <NewsPortal />
      <BooksView />
    </main>
    <footer class="hidden md:flex py-2.5 px-4 md:px-6 border-t border-slate-200/70 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/70 backdrop-blur-md shrink-0 text-slate-500 dark:text-slate-400 text-[11px] font-medium flex-col sm:flex-row items-center justify-between gap-1.5 z-20">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-700 dark:text-slate-300">ListProjek</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="text-slate-500 dark:text-slate-400">Project & Portfolio Management</span>
      </div>
      <p class="text-slate-500 dark:text-slate-400">
        © 2026 <span class="font-semibold text-slate-700 dark:text-slate-300">ListProjek</span> by <span class="font-bold text-brand-600 dark:text-brand-400">Aldi Kurniawan</span>. All rights reserved.
      </p>
    </footer>
  </div>
  <ProjectModal />
  <TaskModal />
  <EventModal />
  <DeployedWebModal />
  <BookModal />
  <BookReaderModal />
  <MobileBottomNav />
  <Toast />
  <script is:inline src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <script is:inline>
    // Simplified router and state management
    let projects = [];
    let activeProjectId = null;
    let currentFilter = "all";
    let currentTaskFilter = "all";
    let searchQuery = "";
    let calendar;

    document.addEventListener("DOMContentLoaded", () => {
      showDashboardView();
      fetchProjects();
      updateThemeIcon();

      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has("login") && window.Ghostoast) {
        Ghostoast.success("Selamat datang kembali di dashboard Anda!", "Login Berhasil");
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    });

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateThemeIcon();
    }

    function updateThemeIcon() {
      const knob = document.getElementById("themeToggleKnob");
      const knobIcon = document.getElementById("themeToggleKnobIcon");
      if (knob && knobIcon) {
        const isDark = document.documentElement.classList.contains("dark");
        if (isDark) {
          knob.classList.add("translate-x-6");
          knobIcon.className = "fa-solid fa-moon text-[9px] text-indigo-400";
        } else {
          knob.classList.remove("translate-x-6");
          knobIcon.className = "fa-solid fa-sun text-[9px] text-amber-500";
        }
      }
    }

    async function fetchProjects() {
      try {
        const res = await fetch("/api/projects");
        projects = await res.json();
        renderDashboard();
        renderDeployedTable();
      } catch (err) {
        console.error("Gagal mengambil data projek:", err);
      }
    }

    function updateSidebarNav(activeNavId) {
      const navBtns = [
        { id: "navProjectBtn", isChild: true, mobileId: "mobileNavProjectBtn", defaultIconClass: "fa-solid fa-layer-group text-slate-400 dark:text-slate-500 w-4 text-center", activeIconClass: "fa-solid fa-layer-group text-white w-4 text-center" },
        { id: "navNewProjectBtn", isChild: true, mobileId: null, defaultIconClass: "fa-solid fa-folder-plus text-slate-400 dark:text-slate-500 w-4 text-center", activeIconClass: "fa-solid fa-folder-plus text-white w-4 text-center" },
        { id: "navDeployedBtn", isChild: true, mobileId: "mobileNavDeployedBtn", defaultIconClass: "fa-solid fa-globe text-slate-400 dark:text-slate-500 w-4 text-center", activeIconClass: "fa-solid fa-globe text-white w-4 text-center" },
        { id: "navCalendarBtn", isChild: false, mobileId: "mobileNavCalendarBtn", defaultIconClass: "fa-solid fa-calendar-days text-slate-400 dark:text-slate-500 w-5 text-center", activeIconClass: "fa-solid fa-calendar-days text-white w-5 text-center" },
        { id: "navBooksBtn", isChild: false, mobileId: "mobileNavBooksBtn", defaultIconClass: "fa-solid fa-book-open text-slate-400 dark:text-slate-500 w-5 text-center", activeIconClass: "fa-solid fa-book-open text-white w-5 text-center" },
        { id: "navNewsBtn", isChild: false, mobileId: "mobileNavNewsBtn", defaultIconClass: "fa-solid fa-newspaper text-slate-400 dark:text-slate-500 w-5 text-center", activeIconClass: "fa-solid fa-newspaper text-white w-5 text-center" }
      ];

      const isProjectSubmenuActive = ["navProjectBtn", "navNewProjectBtn", "navDeployedBtn"].includes(activeNavId);
      if (isProjectSubmenuActive && window.toggleProjectTree) {
        window.toggleProjectTree(true);
      }

      navBtns.forEach(nav => {
        const btn = document.getElementById(nav.id);
        if (btn) {
          const icon = btn.querySelector("i");
          if (nav.id === activeNavId) {
            if (nav.isChild) {
              btn.className = "w-full flex items-center gap-2.5 px-3 py-2 rounded-xl bg-brand-600 text-white font-semibold text-xs shadow-md shadow-brand-500/25 transition-all text-left";
            } else {
              btn.className = "w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-brand-600 text-white font-semibold text-sm shadow-md shadow-brand-500/25 transition-all text-left";
            }
            if (icon) icon.className = nav.activeIconClass;
          } else {
            if (nav.isChild) {
              btn.className = "w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100/80 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white font-medium text-xs transition-all text-left";
            } else {
              btn.className = "w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100/80 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white font-medium text-sm transition-all text-left";
            }
            if (icon) icon.className = nav.defaultIconClass;
          }
        }

        if (nav.mobileId) {
          const mobileBtn = document.getElementById(nav.mobileId);
          if (mobileBtn) {
            if (nav.id === activeNavId) {
              mobileBtn.className = "mobile-nav-item flex flex-col items-center justify-center py-1 px-2 rounded-xl text-brand-400 font-bold transition-all scale-105";
            } else {
              mobileBtn.className = "mobile-nav-item flex flex-col items-center justify-center py-1 px-2 rounded-xl text-slate-400 hover:text-slate-200 transition-all";
            }
          }
        }
      });
    }

    function showView(viewId) {
      document.getElementById("listView").style.display = "none";
      document.getElementById("detailView").style.display = "none";
      document.getElementById("calendarView").style.display = "none";
      const newsView = document.getElementById("newsView");
      if (newsView) newsView.style.display = "none";
      const booksView = document.getElementById("booksView");
      if (booksView) booksView.style.display = "none";
      const deployedView = document.getElementById("deployedView");
      if (deployedView) deployedView.style.display = "none";

      const targetView = document.getElementById(viewId);
      if (targetView) targetView.style.display = "flex";
    }

    function showDashboardView() {
      updateSidebarNav("navProjectBtn");
      activeProjectId = null;
      showView("listView");
      document.getElementById("statsOverview").style.display = "grid";
      document.getElementById("viewTitle").innerText = "Daftar Projek Utama";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "flex";
      renderDashboard();
    }

    function showBooksView() {
      updateSidebarNav("navBooksBtn");
      activeProjectId = null;
      showView("booksView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Read Book / Perpustakaan Digital";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "none";
      fetchBooks();
    }
    window.showBooksView = showBooksView;

    let currentDeployedFilter = "all";

    function showDeployedView() {
      updateSidebarNav("navDeployedBtn");
      activeProjectId = null;
      showView("deployedView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Web Online & Portofolio Deployed";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "flex";
      renderDeployedTable();
    }

    function showProjectDetailView(id) {
      updateSidebarNav("navProjectBtn");
      activeProjectId = id;
      showView("detailView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Detail Task Projek";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "none";
      renderDashboard();
    }

    let currentMockupTheme = 'blue';

    const themeGradients = {
      blue: 'from-brand-600 via-indigo-600 to-violet-700',
      purple: 'from-purple-600 via-fuchsia-600 to-pink-700',
      emerald: 'from-emerald-600 via-teal-600 to-cyan-700',
      rose: 'from-rose-600 via-red-600 to-orange-700',
      amber: 'from-amber-500 via-orange-600 to-yellow-600',
    };

    const themeSolidColors = {
      blue: '#2563eb',
      purple: '#9333ea',
      emerald: '#059669',
      rose: '#e11d48',
      amber: '#d97706',
    };

    function setMockupTheme(theme) {
      currentMockupTheme = theme;
      const banner = document.getElementById("mockupCardBanner");
      if (banner && themeGradients[theme]) {
        banner.className = `bg-gradient-to-br ${themeGradients[theme]} p-6 text-white relative overflow-hidden transition-all duration-300`;
      }

      document.querySelectorAll(".color-theme-btn").forEach((btn) => {
        const icon = btn.querySelector(".theme-check-icon");
        if (btn.dataset.theme === theme) {
          if (icon) icon.classList.remove("hidden");
          btn.classList.add("ring-2", "ring-brand-500", "ring-offset-2", "dark:ring-offset-slate-900", "scale-110");
        } else {
          if (icon) icon.classList.add("hidden");
          btn.classList.remove("ring-2", "ring-brand-500", "ring-offset-2", "dark:ring-offset-slate-900", "scale-110");
        }
      });
    }

    async function fetchEvents() {
      try {
        const res = await fetch("/api/events");
        if (!res.ok) throw new Error("Gagal mengambil data acara");
        const data = await res.json();
        
        const countBadge = document.getElementById("eventCountBadge");
        if (countBadge) countBadge.innerText = `${data.length} Acara`;

        return data.map(e => {
          const colorKey = e.color || 'blue';
          const bgColor = themeSolidColors[colorKey] || themeSolidColors.blue;
          return {
            id: e.id,
            title: e.title,
            start: e.start,
            end: e.end,
            allDay: true,
            backgroundColor: bgColor,
            borderColor: 'transparent',
            extendedProps: { color: colorKey }
          };
        });
      } catch (err) {
        console.error("Gagal mengambil data events:", err);
        return [];
      }
    }

    const themeGradientsMap = {
      blue: 'linear-gradient(135deg, #2563eb, #4f46e5)',
      purple: 'linear-gradient(135deg, #9333ea, #c026d3)',
      emerald: 'linear-gradient(135deg, #059669, #0d9488)',
      rose: 'linear-gradient(135deg, #e11d48, #ea580c)',
      amber: 'linear-gradient(135deg, #d97706, #ca8a04)',
    };

    async function showCalendarView() {
      updateSidebarNav("navCalendarBtn");
      showView("calendarView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Kalender & Jadwal";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "none";
      const events = await fetchEvents();
      if (calendar) {
        calendar.removeAllEvents();
        calendar.addEventSource(events);
      } else {
        initCalendar(events);
      }
    }
    
    function renderDashboard() {
      updateStats();
      if (activeProjectId) {
        renderTaskDetailView();
      } else {
        renderProjectsTableView();
      }
    }

    async function api(url, options = {}) {
      const res = await fetch(url, {
        headers: { "Content-Type": "application/json" },
        ...options,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Request failed");
      return data;
    }

    function toggleSidebar() {
      const sidebar = document.getElementById("sidebar");
      const overlay = document.getElementById("sidebarOverlay");
      sidebar.classList.toggle("-translate-x-full");
      overlay.classList.toggle("hidden");
    }

    function openModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('hidden');
        setTimeout(() => modal.classList.add('open'), 10);
        if (modalId === "projectModal") {
          updateSidebarNav("navNewProjectBtn");
        }
      }
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('open');
        setTimeout(() => {
          modal.classList.add('hidden');
          if (modalId === "projectModal") {
            document.getElementById("projectForm").reset();
            updateSidebarNav("navProjectBtn");
          }
          if (modalId === "taskModal") {
            document.getElementById("taskForm").reset();
            if (typeof clearTaskParentId === 'function') clearTaskParentId();
          }
          if (modalId === "deployedWebModal") document.getElementById("deployedWebForm").reset();
        }, 300);
      }
    }

    function openEventModal(selectedDate = "") {
      const modal = document.getElementById("eventModal");
      if (!modal) return;
      
      const form = document.getElementById("eventForm");
      if (form) form.reset();
      
      setMockupTheme('blue');
      const todayStr = selectedDate || new Date().toISOString().split("T")[0];
      const startDateInput = document.getElementById("eventStartDate");
      if (startDateInput) startDateInput.value = todayStr;
      
      updateMockupPreview();

      modal.classList.remove("hidden", "mockup-closing");
      setTimeout(() => modal.classList.add("open"), 10);
    }

    function closeEventModal() {
      const modal = document.getElementById("eventModal");
      if (!modal) return;

      modal.classList.remove("open");
      modal.classList.add("mockup-closing");

      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("mockup-closing");
        const form = document.getElementById("eventForm");
        if (form) form.reset();
      }, 450);
    }

    function updateMockupPreview() {
      const titleInput = document.getElementById("eventTitle");
      const startDateInput = document.getElementById("eventStartDate");
      const endDateInput = document.getElementById("eventEndDate");
      
      const mockupTitle = document.getElementById("eventMockupTitle");
      const mockupDate = document.getElementById("eventMockupDate");

      const titleVal = titleInput?.value.trim() || "Judul Acara Baru";
      const startVal = startDateInput?.value ? new Date(startDateInput.value).toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' }) : "Pilih tanggal...";
      const endVal = endDateInput?.value ? " - " + new Date(endDateInput.value).toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' }) : "";

      if (mockupTitle) mockupTitle.innerText = titleVal;
      if (mockupDate) mockupDate.innerHTML = `<i class="fa-regular fa-clock"></i> ${startVal}${endVal}`;
    }

    async function saveEvent(e) {
      if (e) e.preventDefault();
      
      const title = document.getElementById("eventTitle")?.value.trim();
      const start = document.getElementById("eventStartDate")?.value;
      const end = document.getElementById("eventEndDate")?.value || null;

      if (!title || !start) {
        if (window.Ghostoast) Ghostoast.error("Judul dan tanggal mulai wajib diisi", "Form Tidak Lengkap");
        return;
      }

      const saveBtn = document.getElementById("saveEventBtn");
      const saveBtnText = document.getElementById("saveEventBtnText");
      if (saveBtn) saveBtn.disabled = true;
      if (saveBtnText) saveBtnText.innerText = "Menyimpan...";

      if (window.showLoadingScreen) {
        window.showLoadingScreen('Menyimpan Acara Kalender', 'Menambahkan acara ke dalam jadwal Anda...');
      }

      try {
        const newEvent = await api("/api/events", {
          method: "POST",
          body: JSON.stringify({ title, start, end, color: currentMockupTheme }),
        });

        // Instantly refresh all events from DB into calendar
        const eventsList = await fetchEvents();
        if (calendar) {
          calendar.removeAllEvents();
          calendar.addEventSource(eventsList);
        }

        closeEventModal();
        if (window.Ghostoast) {
          Ghostoast.success(
            `Acara "${title}" tersimpan di database.`,
            "Acara Berhasil Dibuat"
          );
        }
      } catch (err) {
        console.error("Gagal menyimpan acara:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menyimpan acara ke database.", "Terjadi Kesalahan");
        }
      } finally {
        if (saveBtn) saveBtn.disabled = false;
        if (saveBtnText) saveBtnText.innerText = "Simpan Acara";
        if (window.hideLoadingScreen) {
          window.hideLoadingScreen();
        }
      }
    }

    async function deleteEvent(eventId) {
      try {
        await api(`/api/events/${eventId}`, { method: "DELETE" });
        const eventsList = await fetchEvents();
        if (calendar) {
          calendar.removeAllEvents();
          calendar.addEventSource(eventsList);
        }
        if (window.Ghostoast) {
          Ghostoast.success("Acara berhasil dihapus dari database.", "Acara Dihapus");
        }
      } catch (err) {
        console.error("Gagal menghapus acara:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menghapus acara.", "Terjadi Kesalahan");
        }
      }
    }

    let allNewsArticles = [];
    let currentNewsCategory = "all";
    let newsSearchQuery = "";

    async function showNewsView() {
      updateSidebarNav("navNewsBtn");
      showView("newsView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Portal Berita Trending";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "none";
      fetchNewsData();
    }

    async function fetchNewsData(forceRefresh = false) {
      const grid = document.getElementById("newsGrid");
      const refreshIcon = document.getElementById("refreshNewsIcon");
      const refreshBtn = document.getElementById("refreshNewsBtn");

      if (refreshIcon) refreshIcon.classList.add("animate-spin");
      if (refreshBtn) refreshBtn.disabled = true;

      if (grid && (!allNewsArticles || allNewsArticles.length === 0 || forceRefresh)) {
        grid.innerHTML = Array(6).fill(0).map(() => `
          <div class="animate-pulse bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="h-44 bg-slate-200 dark:bg-slate-800 rounded-xl"></div>
            <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-3/4"></div>
            <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-full"></div>
            <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-2/3"></div>
          </div>
        `).join('');
      }

      try {
        const url = forceRefresh ? '/api/news?refresh=true' : '/api/news';
        const res = await fetch(url);
        const data = await res.json();
        
        allNewsArticles = data.results || [];
        
        const updatedLabel = document.getElementById("newsLastUpdated");
        if (updatedLabel) {
          if (data.source === 'cache') {
            updatedLabel.innerHTML = `<i class="fa-regular fa-clock mr-1 text-sky-400"></i> Cache (${data.nextUpdateInMinutes}m tersisa)`;
          } else {
            updatedLabel.innerHTML = `<i class="fa-solid fa-check mr-1 text-emerald-400"></i> Berita Terkini (Live)`;
          }
        }

        if (forceRefresh && window.Ghostoast) {
          Ghostoast.success("Data berita berhasil diperbarui.", "Portal Berita");
        }

        renderNewsGrid();
      } catch (err) {
        console.error("Gagal mengambil berita:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal memuat berita terkini.", "Terjadi Kesalahan");
        }
      } finally {
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
        if (refreshBtn) refreshBtn.disabled = false;
      }
    }

    function setNewsCategory(cat) {
      currentNewsCategory = cat;
      document.querySelectorAll(".news-cat-btn").forEach(btn => {
        btn.classList.remove("bg-brand-600", "text-white", "font-semibold");
        btn.classList.add("text-slate-600", "dark:text-slate-400", "font-medium");
      });
      const activeBtn = document.getElementById(`newsCat-${cat}`);
      if (activeBtn) {
        activeBtn.classList.add("bg-brand-600", "text-white", "font-semibold");
        activeBtn.classList.remove("text-slate-600", "dark:text-slate-400", "font-medium");
      }
      renderNewsGrid();
    }

    function handleNewsSearch() {
      const input = document.getElementById("newsSearchInput");
      newsSearchQuery = input ? input.value.toLowerCase().trim() : '';
      renderNewsGrid();
    }

    function renderNewsGrid() {
      const grid = document.getElementById("newsGrid");
      const emptyState = document.getElementById("newsEmptyState");
      if (!grid) return;

      let filtered = allNewsArticles.filter(item => {
        if (currentNewsCategory !== 'all') {
          const itemCats = (item.category || []).map(c => String(c).toLowerCase());
          if (!itemCats.includes(currentNewsCategory.toLowerCase())) {
            return false;
          }
        }

        if (newsSearchQuery) {
          const matchTitle = (item.title || '').toLowerCase().includes(newsSearchQuery);
          const matchDesc = (item.description || '').toLowerCase().includes(newsSearchQuery);
          const matchSource = (item.source_name || '').toLowerCase().includes(newsSearchQuery);
          return matchTitle || matchDesc || matchSource;
        }

        return true;
      });

      if (filtered.length === 0) {
        grid.innerHTML = '';
        if (emptyState) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
        }
        return;
      }

      if (emptyState) {
        emptyState.classList.add("hidden");
        emptyState.classList.remove("flex");
      }

      grid.innerHTML = filtered.map(item => {
        const title = escapeHtml(item.title);
        const desc = escapeHtml(item.description);
        const sourceName = escapeHtml(item.source_name);
        const categoryTag = item.category?.[0] ? escapeHtml(String(item.category[0]).toUpperCase()) : 'BERITA';
