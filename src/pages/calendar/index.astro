---
---
<div
  id="calendarView"
  class="task-detail-view flex-col flex-1 min-h-0 space-y-4 overflow-hidden"
  style="display: none;"
>
  <!-- Modern Calendar Header Banner -->
  <div class="bg-white dark:bg-slate-900 p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm text-slate-900 dark:text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition-colors duration-200">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white flex items-center justify-center text-xl font-bold shadow-md shadow-brand-500/20">
        <i class="fa-solid fa-calendar-alt"></i>
      </div>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <h3 class="text-base font-extrabold tracking-tight text-slate-900 dark:text-white">Kalender & Agenda Kerja</h3>
          <span id="eventCountBadge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-200 dark:bg-slate-800 dark:text-brand-400 dark:border-slate-700">
            0 Acara
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-2 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-ping"></span>
          Terhubung ke Database PostgreSQL (Prisma Live Sync)
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end">
      <button
        type="button"
        onclick="openEventModal()"
        class="w-full sm:w-auto px-5 py-2.5 bg-brand-600 hover:bg-brand-700 active:scale-95 text-white rounded-2xl text-xs font-bold shadow-md shadow-brand-600/20 transition-all flex items-center justify-center gap-2 group cursor-pointer"
      >
        <i class="fa-solid fa-plus text-xs group-hover:rotate-90 transition-transform duration-300"></i>
        <span>Tambah Acara Baru</span>
      </button>
    </div>
  </div>

  <!-- Calendar Container -->
  <div class="bg-white dark:bg-slate-900 p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xl dark:shadow-slate-950/50 flex-1 min-h-0 flex flex-col overflow-auto relative transition-colors duration-200">
    <div id="calendar" class="flex-1 min-h-[520px]"></div>
  </div>
</div>
