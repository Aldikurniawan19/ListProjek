---

---

<div
  id="eventModal"
  class="fixed inset-0 bg-slate-950/70 z-50 flex items-center justify-center p-4 hidden backdrop-blur-md modal mockup-modal transition-all"
>
  <div
    class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-2xl shadow-slate-900/30 w-full max-w-lg overflow-hidden modal-content relative flex flex-col transition-colors duration-200"
  >
    <!-- Mobile Drag Handle Bar -->
    <div
      class="w-12 h-1.5 bg-slate-300 dark:bg-slate-700 rounded-full mx-auto my-2 sm:hidden shrink-0"
    >
    </div>

    <!-- Dynamic Glassmorphism Live Card Banner Header -->
    <div
      id="mockupCardBanner"
      class="bg-gradient-to-br from-brand-600 via-indigo-600 to-violet-700 p-6 text-white relative overflow-hidden transition-all duration-300"
    >
      <div
        class="absolute -right-10 -bottom-10 w-36 h-36 bg-white/10 rounded-full blur-2xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -left-10 -top-10 w-28 h-28 bg-white/10 rounded-full blur-xl pointer-events-none"
      >
      </div>

      <!-- Close Button Top Right -->
      <button
        type="button"
        onclick="closeEventModal()"
        class="absolute top-4 right-4 z-20 text-white/70 hover:text-white hover:bg-white/20 w-8 h-8 rounded-full flex items-center justify-center text-xs backdrop-blur-md transition-all active:scale-95"
        title="Tutup Modal"
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>

      <div class="flex items-start justify-between relative z-10 pr-8">
        <div class="space-y-1.5 flex-1">
          <div class="flex items-center gap-2">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-white/20 text-white backdrop-blur-md border border-white/20"
            >
              <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i> Live Preview
              Acara
            </span>
            <span
              id="mockupTagBadge"
              class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-black/20 text-white backdrop-blur-md"
            >
              Kategori: Acara
            </span>
          </div>

          <h4
            id="eventMockupTitle"
            class="text-xl font-extrabold tracking-tight text-white drop-shadow-sm truncate max-w-[320px]"
          >
            Judul Acara Baru
          </h4>

          <p
            id="eventMockupDate"
            class="text-xs text-blue-100/90 font-medium flex items-center gap-1.5"
          >
            <i class="fa-regular fa-clock"></i> Pilih tanggal...
          </p>
        </div>

        <div
          class="w-12 h-12 rounded-2xl bg-white/15 backdrop-blur-xl border border-white/20 flex items-center justify-center text-white text-xl shadow-lg shrink-0"
        >
          <i class="fa-solid fa-calendar-check"></i>
        </div>
      </div>
    </div>

    <!-- Form Body -->
    <form
      id="eventForm"
      onsubmit="saveEvent(event)"
      class="p-6 space-y-4 bg-slate-50/70 dark:bg-slate-900/90 transition-colors duration-200"
    >
      <!-- Input Judul -->
      <div>
        <label
          class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between"
          ><span>Judul Acara <span class="text-rose-500">*</span></span>
          <span
            class="text-[10px] font-normal text-slate-400 dark:text-slate-500"
            >Diperlukan</span
          >
        </label>
        <div class="relative">
          <input
            type="text"
            id="eventTitle"
            required
            placeholder="Contoh: Launching Website Utama & Demo Client"
            oninput="updateMockupPreview()"
            class="w-full pl-3.5 pr-9 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 shadow-sm transition-all text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
          />
          <div
            class="absolute right-3 top-2.5 text-slate-400 dark:text-slate-500 text-xs pointer-events-none"
          >
            <i class="fa-solid fa-pen-nib"></i>
          </div>
        </div>
      </div>

      <!-- Dates Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label
            class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
            >Tanggal Mulai <span class="text-rose-500">*</span></label
          >
          <input
            type="date"
            id="eventStartDate"
            required
            onchange="updateMockupPreview()"
            class="w-full px-3.5 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 shadow-sm transition-all text-slate-800 dark:text-white"
          />
        </div>
        <div>
          <label
            class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
            >Tanggal Selesai <span
              class="text-slate-400 dark:text-slate-500 font-normal"
              >(Opsional)</span
            ></label
          >
          <input
            type="date"
            id="eventEndDate"
            onchange="updateMockupPreview()"
            class="w-full px-3.5 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 shadow-sm transition-all text-slate-800 dark:text-white"
          />
        </div>
      </div>

      <!-- Color Theme Picker -->
      <div>
        <label
          class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
          >Warna Tampilan Acara</label
        >
        <div class="flex items-center gap-2.5 pt-0.5" id="colorThemePicker">
          <button
            type="button"
            data-theme="blue"
            onclick="setMockupTheme('blue')"
            class="color-theme-btn w-7 h-7 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 border-2 border-white dark:border-slate-700 shadow-md hover:scale-110 active:scale-95 transition-all flex items-center justify-center text-white text-xs cursor-pointer"
            title="Biru (Default)"
          >
            <i class="fa-solid fa-check text-[10px] theme-check-icon"></i>
          </button>
          <button
            type="button"
            data-theme="purple"
            onclick="setMockupTheme('purple')"
            class="color-theme-btn w-7 h-7 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 border-2 border-white dark:border-slate-700 shadow-md hover:scale-110 active:scale-95 transition-all flex items-center justify-center text-white text-xs cursor-pointer"
            title="Ungu"
          >
            <i class="fa-solid fa-check text-[10px] theme-check-icon hidden"
            ></i>
          </button>
          <button
            type="button"
            data-theme="emerald"
            onclick="setMockupTheme('emerald')"
            class="color-theme-btn w-7 h-7 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 border-2 border-white dark:border-slate-700 shadow-md hover:scale-110 active:scale-95 transition-all flex items-center justify-center text-white text-xs cursor-pointer"
            title="Hijau"
          >
            <i class="fa-solid fa-check text-[10px] theme-check-icon hidden"
            ></i>
          </button>
          <button
            type="button"
            data-theme="rose"
            onclick="setMockupTheme('rose')"
            class="color-theme-btn w-7 h-7 rounded-xl bg-gradient-to-r from-rose-600 to-orange-600 border-2 border-white dark:border-slate-700 shadow-md hover:scale-110 active:scale-95 transition-all flex items-center justify-center text-white text-xs cursor-pointer"
            title="Merah"
          >
            <i class="fa-solid fa-check text-[10px] theme-check-icon hidden"
            ></i>
          </button>
          <button
            type="button"
            data-theme="amber"
            onclick="setMockupTheme('amber')"
            class="color-theme-btn w-7 h-7 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 border-2 border-white dark:border-slate-700 shadow-md hover:scale-110 active:scale-95 transition-all flex items-center justify-center text-white text-xs cursor-pointer"
            title="Kuning"
          >
            <i class="fa-solid fa-check text-[10px] theme-check-icon hidden"
            ></i>
          </button>
        </div>
      </div>

      <!-- Footer Action Buttons -->
      <div
        class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-800"
      >
        <div
          class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 dark:text-slate-400"
        >
          <span
            class="w-2 h-2 rounded-full bg-emerald-500 animate-ping inline-block"
          ></span>
          <span></span>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            onclick="closeEventModal()"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-200/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white active:scale-95 transition-all"
          >
            Batal
          </button>
          <button
            type="submit"
            id="saveEventBtn"
            class="px-5 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-brand-600 via-indigo-600 to-violet-600 hover:from-brand-700 hover:to-violet-700 text-white shadow-lg shadow-brand-500/25 active:scale-95 transition-all flex items-center gap-2"
          >
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span id="saveEventBtnText">Simpan Acara</span>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
