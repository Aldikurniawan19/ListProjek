---
import LoadingScreen from '~/components/LoadingScreen.astro';

interface Props {
	title?: string;
}

const { title = 'Dashboard Progres Projek' } = Astro.props;
---
<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<script is:inline>
			tailwind.config = {
				darkMode: 'class',
				theme: {
					extend: {
						fontFamily: {
							sans: ['Inter', 'sans-serif'],
						},
						colors: {
							brand: {
								50: '#eff6ff',
								100: '#dbeafe',
								200: '#bfdbfe',
								300: '#93c5fd',
								400: '#60a5fa',
								500: '#3b82f6',
								600: '#2563eb',
								700: '#1d4ed8',
								800: '#1e40af',
								900: '#1e3a8a',
								950: '#172554',
							}
						}
					}
				}
			};

			(function() {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
		<style is:global>
			::-webkit-scrollbar { width: 6px; height: 6px; }
			::-webkit-scrollbar-track { background: #f1f5f9; }
			.dark ::-webkit-scrollbar-track { background: #0f172a; }
			::-webkit-scrollbar-thumb { background: #bfdbfe; border-radius: 4px; }
			.dark ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
			::-webkit-scrollbar-thumb:hover { background: #2563eb; }
			table { border-collapse: separate; border-spacing: 0; }
			.task-detail-view { display: none; }
			.task-detail-view.active-view { display: flex; }
			@keyframes ghostoastProgress {
				from { width: 100%; }
				to { width: 0%; }
			}
      .modal-content {
        transition: transform 0.3s ease-out, opacity 0.3s ease-out;
        transform: scale(0.95);
        opacity: 0;
      }
      .modal.open .modal-content {
        transform: scale(1);
        opacity: 1;
      }

      /* 3D Mockup Modal Exit & Entrance Animations */
      @keyframes mockupExit {
        0% {
          opacity: 1;
          transform: perspective(1200px) rotateX(0deg) rotateY(0deg) scale(1) translateY(0);
          filter: blur(0px);
        }
        35% {
          opacity: 0.9;
          transform: perspective(1200px) rotateX(-12deg) rotateY(6deg) scale(0.92) translateY(-15px);
          box-shadow: 0 30px 60px -12px rgba(37, 99, 235, 0.35);
        }
        100% {
          opacity: 0;
          transform: perspective(1200px) rotateX(-35deg) rotateY(18deg) scale(0.55) translateY(120px);
          filter: blur(10px);
        }
      }

      @keyframes mockupEnter {
        0% {
          opacity: 0;
          transform: perspective(1200px) rotateX(25deg) scale(0.8) translateY(40px);
          filter: blur(8px);
        }
        70% {
          transform: perspective(1200px) rotateX(-3deg) scale(1.02) translateY(-4px);
        }
        100% {
          opacity: 1;
          transform: perspective(1200px) rotateX(0deg) scale(1) translateY(0);
          filter: blur(0px);
        }
      }

      .modal.mockup-modal .modal-content {
        transform-style: preserve-3d;
        backface-visibility: hidden;
      }

      .modal.mockup-modal.open .modal-content {
        animation: mockupEnter 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .modal.mockup-closing .modal-content {
        animation: mockupExit 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      }

      .modal.mockup-closing {
        transition: opacity 0.45s ease;
        opacity: 0;
      }
      
      /* Ultra-Modern FullCalendar Custom Styling */
      :root {
        --fc-border-color: #f1f5f9;
        --fc-daygrid-event-dot-width: 8px;
        --fc-list-event-dot-width: 10px;
        --fc-event-border-color: transparent;
        --fc-event-text-color: #ffffff;
        --fc-event-bg-color: #2563eb;
        --fc-button-bg-color: #f8fafc;
        --fc-button-text-color: #475569;
        --fc-button-hover-bg-color: #eff6ff;
        --fc-today-bg-color: rgba(239, 246, 255, 0.6);
      }

      .fc {
        font-family: 'Inter', sans-serif !important;
      }

      .fc .fc-toolbar {
        margin-bottom: 1.25rem !important;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .fc-toolbar-title {
        font-size: 1.35rem !important;
        font-weight: 800 !important;
        color: #0f172a !important;
        letter-spacing: -0.02em !important;
      }

      .dark .fc-toolbar-title {
        color: #f8fafc !important;
      }

      .fc .fc-button {
        padding: 0.5rem 1rem !important;
        font-size: 0.8125rem !important;
        font-weight: 600 !important;
        border-radius: 0.75rem !important;
        text-transform: capitalize !important;
        border: 1px solid #e2e8f0 !important;
        background: #ffffff !important;
        color: #334155 !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }

      .dark .fc .fc-button {
        background: #1e293b !important;
        color: #cbd5e1 !important;
        border-color: #334155 !important;
      }

      .fc .fc-button:hover {
        background: #f1f5f9 !important;
        color: #1e293b !important;
        border-color: #cbd5e1 !important;
        transform: translateY(-1px);
      }

      .dark .fc .fc-button:hover {
        background: #334155 !important;
        color: #ffffff !important;
        border-color: #475569 !important;
      }

      .fc .fc-button-primary:not(:disabled).fc-button-active, 
      .fc .fc-button-primary:not(:disabled):active {
        background: linear-gradient(135deg, #2563eb, #4f46e5) !important;
        color: #ffffff !important;
        border-color: transparent !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3) !important;
      }

      .fc-theme-standard .fc-scrollgrid {
        border-color: #e2e8f0 !important;
        border-radius: 1rem !important;
        overflow: hidden;
      }

      .dark .fc-theme-standard .fc-scrollgrid {
        border-color: #334155 !important;
        background-color: #0f172a !important;
      }

      .fc-theme-standard td, .fc-theme-standard th {
        border-color: #f1f5f9 !important;
      }

      .dark .fc-theme-standard td, .dark .fc-theme-standard th {
        border-color: #1e293b !important;
      }

      .fc-col-header, .fc-col-header-cell, .fc-scrollgrid-sync-table {
        background-color: #f8fafc !important;
      }

      .dark .fc-col-header, .dark .fc-col-header-cell, .dark .fc-scrollgrid-sync-table {
        background-color: #0f172a !important;
      }

      .fc-col-header-cell-cushion {
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        color: #64748b !important;
        padding: 0.65rem 0 !important;
      }

      .dark .fc-col-header-cell-cushion {
        color: #94a3b8 !important;
      }

      .fc-daygrid-day {
        background-color: #ffffff !important;
        transition: background-color 0.2s ease !important;
      }

      .dark .fc-daygrid-day {
        background-color: #0f172a !important;
      }

      .fc-daygrid-day:hover {
        background-color: #f8fafc !important;
      }

      .dark .fc-daygrid-day:hover {
        background-color: #1e293b !important;
      }

      .fc-daygrid-day-number {
        font-size: 0.8125rem !important;
        font-weight: 600 !important;
        color: #475569 !important;
        padding: 0.35rem 0.6rem !important;
        margin: 0.25rem !important;
        border-radius: 9999px;
        transition: all 0.2s ease;
      }

      .dark .fc-daygrid-day-number {
        color: #cbd5e1 !important;
      }

      .dark .fc-day-other .fc-daygrid-day-number {
        color: #475569 !important;
        opacity: 0.6;
      }

      .fc-day-today {
        background-color: rgba(239, 246, 255, 0.7) !important;
      }

      .dark .fc-day-today {
        background-color: rgba(30, 58, 138, 0.25) !important;
      }

      .fc-day-today .fc-daygrid-day-number {
        background: linear-gradient(135deg, #2563eb, #4f46e5) !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        box-shadow: 0 3px 10px rgba(37, 99, 235, 0.35);
        width: 1.85rem;
        height: 1.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .fc-event {
        border: none !important;
        border-radius: 0.5rem !important;
        padding: 0.35rem 0.6rem !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
        cursor: pointer !important;
        transition: transform 0.15s ease, box-shadow 0.15s ease !important;
        margin-top: 2px !important;
        margin-bottom: 2px !important;
      }

      .fc-event:hover {
        transform: translateY(-1px) scale(1.01) !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4) !important;
      }

      .fc-event-title {
        font-weight: 600 !important;
        letter-spacing: -0.01em;
      }
		</style>
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans min-h-screen flex flex-col md:flex-row antialiased transition-colors duration-200">
		<slot />
		<div id="modal-container"></div>
		<LoadingScreen />
	</body>
</html>
