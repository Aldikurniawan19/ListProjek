    function updateStats() {
      const internalProjects = projects.filter(p => !p.liveUrl && (!p.category || !p.category.includes("Web Live")));
      const totalProjects = internalProjects.length;
      let totalTasks = 0;
      let completedTasks = 0;
      let totalPercentageSum = 0;

      internalProjects.forEach((p) => {
        const tasks = p.tasks || [];
        const pTotal = tasks.length;
        const pCompleted = tasks.filter((t) => t.completed).length;
        totalTasks += pTotal;
        completedTasks += pCompleted;
        const pProgress = pTotal > 0 ? (pCompleted / pTotal) * 100 : 0;
        totalPercentageSum += pProgress;
      });

      const avgProgress =
        totalProjects > 0 ? Math.round(totalPercentageSum / totalProjects) : 0;

      document.getElementById("statTotalProjects").innerText = totalProjects;
      document.getElementById("statTotalTasks").innerText = totalTasks;
      document.getElementById("statCompletedTasks").innerText = completedTasks;
      document.getElementById("statAvgProgress").innerText = avgProgress + "%";
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatExternalUrl(url) {
      if (!url || url === '#') return '#';
      const trimmed = String(url).trim();
      if (!trimmed) return '#';
      if (/^https?:\/\//i.test(trimmed)) {
        return trimmed;
      }
      return `https://${trimmed}`;
    }

    function renderProjectsTableView() {
      const tbody = document.getElementById("projectsTableBody");
      const mobileList = document.getElementById("projectsMobileList");
      const emptyState = document.getElementById("tableEmptyState");

      if (tbody) tbody.innerHTML = "";
      if (mobileList) mobileList.innerHTML = "";

      let filtered = projects.filter((p) => {
        // Exclude live deployed websites from internal task management table
        if (p.liveUrl || (p.category && p.category.includes("Web Live"))) return false;

        const tasks = p.tasks || [];
        const total = tasks.length;
        const completed = tasks.filter((t) => t.completed).length;
        const isCompleted = total > 0 && completed === total;

        if (currentFilter === "in-progress" && isCompleted) return false;
        if (currentFilter === "completed" && !isCompleted) return false;

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchTitle = (p.title || "").toLowerCase().includes(q);
          const matchCategory = (p.category || "").toLowerCase().includes(q);
          const matchDesc = (p.description || "").toLowerCase().includes(q);
          const matchTask = tasks.some(
            (t) =>
              (t.title || "").toLowerCase().includes(q) ||
              (t.description || "").toLowerCase().includes(q),
          );
          return matchTitle || matchCategory || matchDesc || matchTask;
        }

        return true;
      });

      const countLabel = document.getElementById("projectCountLabel");
      if (countLabel) countLabel.innerText = `Menampilkan ${filtered.length} Projek`;

      if (emptyState) {
        if (filtered.length === 0) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
        } else {
          emptyState.classList.add("hidden");
          emptyState.classList.remove("flex");
        }
      }

      filtered.forEach((p, index) => {
        const tasks = p.tasks || [];
        const totalTasks = tasks.length;
        const completedTasks = tasks.filter((t) => t.completed).length;
        const progress =
          totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
        const isCompleted = totalTasks > 0 && completedTasks === totalTasks;

        const tr = document.createElement("tr");
        const bgRow =
          index % 2 === 0
            ? "bg-slate-50/60 dark:bg-slate-900/60 hover:bg-slate-100 dark:hover:bg-slate-800/80"
            : "bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800/80";
        tr.className = `${bgRow} cursor-pointer transition-colors group`;
        tr.onclick = () => showProjectDetailView(p.id);

        tr.innerHTML = `
					<td class="px-4 py-3">
						<div class="font-bold text-slate-900 dark:text-white text-xs sm:text-sm group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors flex items-center gap-2">
							<span>${escapeHtml(p.title)}</span>
							${p.liveUrl ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 whitespace-nowrap">Deployed</span>` : ''}
						</div>
						<div class="text-slate-500 dark:text-slate-400 text-[11px] sm:text-xs line-clamp-1 mt-0.5 font-normal">
							${escapeHtml(p.description)}
						</div>
						${p.liveUrl ? `<div class="mt-1 flex items-center gap-2"><a href="${escapeHtml(p.liveUrl)}" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/80 hover:underline"><i class="fa-solid fa-globe text-[9px]"></i> ${escapeHtml(p.liveUrl)}</a></div>` : ''}
					</td>
					<td class="px-4 py-3 whitespace-nowrap">
						<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 whitespace-nowrap">
							${escapeHtml(p.category)}
						</span>
					</td>
					<td class="px-4 py-3 whitespace-nowrap text-xs font-medium text-slate-700 dark:text-slate-300">
						<i class="fa-regular fa-check-square mr-1 text-brand-500"></i> ${completedTasks} / ${totalTasks} Task
					</td>
					<td class="px-4 py-3 whitespace-nowrap">
						<div class="flex items-center gap-2">
							<div class="w-full bg-slate-100 dark:bg-slate-800 h-2.5 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700">
								<div class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: ${progress}%"></div>
							</div>
							<span class="font-bold text-[11px] text-brand-700 dark:text-brand-400 w-8 text-right">${progress}%</span>
						</div>
					</td>
					<td class="px-4 py-3 whitespace-nowrap">
						${
              isCompleted
                ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold whitespace-nowrap bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
								<i class="fa-solid fa-check text-[8px]"></i> Selesai
							 </span>`
                : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold whitespace-nowrap bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
								<i class="fa-solid fa-spinner text-[8px] animate-spin"></i> Sedang Berjalan
							 </span>`
            }
					</td>
					<td class="px-4 py-3 whitespace-nowrap text-center">
						<div class="flex items-center justify-center gap-1.5">
							<button onclick="event.stopPropagation(); showProjectDetailView('${p.id}')" class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 rounded-lg text-[11px] font-semibold transition-all border border-slate-200 dark:border-slate-700 flex items-center gap-1">
								<span>Buka Task</span>
								<i class="fa-solid fa-chevron-right text-[9px]"></i>
							</button>
							<button onclick="deleteProject('${p.id}', event)" title="Hapus Projek" class="text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-1 rounded-lg transition-colors">
								<i class="fa-regular fa-trash-can text-xs"></i>
							</button>
						</div>
					</td>
				`;

        if (tbody) tbody.appendChild(tr);

        if (mobileList) {
          const card = document.createElement("div");
          card.className = "p-3.5 bg-white dark:bg-slate-900 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors flex flex-col gap-2";
          card.onclick = () => showProjectDetailView(p.id);
          card.innerHTML = `
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="text-xs font-bold text-slate-900 dark:text-white truncate">${escapeHtml(p.title)}</span>
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">${escapeHtml(p.category)}</span>
                  ${p.liveUrl ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">Deployed</span>` : ''}
                </div>
                ${p.description ? `<p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-1 font-normal">${escapeHtml(p.description)}</p>` : ''}
              </div>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${isCompleted ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700'}">
                ${isCompleted ? 'Selesai' : 'Sedang Berjalan'}
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px]">
              <div class="flex items-center gap-2 flex-1 min-w-0">
                <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700 flex-1">
                  <div class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: ${progress}%"></div>
                </div>
                <span class="font-bold text-brand-600 dark:text-brand-400 text-[10px] shrink-0">${progress}%</span>
              </div>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium shrink-0">
                <i class="fa-regular fa-check-square mr-1 text-brand-500"></i>${completedTasks}/${totalTasks} Task
              </span>
              <button onclick="deleteProject('${p.id}', event)" title="Hapus Projek" class="text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-1 rounded-lg transition-colors shrink-0">
                <i class="fa-regular fa-trash-can text-xs"></i>
              </button>
            </div>
          `;
          mobileList.appendChild(card);
        }
      });
    }

    async function quickAddTask(e) {
      e.preventDefault();
      if (!activeProjectId) return;
      const input = document.getElementById("quickTaskInput");
      const title = input ? input.value.trim() : "";
      if (!title) return;

      try {
        const task = await api(`/api/projects/${activeProjectId}/tasks`, {
          method: "POST",
          body: JSON.stringify({ title, description: "" }),
        });
        const project = projects.find((p) => p.id === activeProjectId);
        if (project) project.tasks.push(task);
        if (input) input.value = "";
        renderDashboard();
      } catch (err) {
        console.error("Gagal menyimpan task:", err);
        alert("Gagal menyimpan task.");
      }
    }

    function renderTaskDetailView() {
      const project = projects.find((p) => p.id === activeProjectId);
      if (!project) {
        showDashboardView();
        return;
      }

      const totalTasks = project.tasks ? project.tasks.length : 0;
      const completedTasks = project.tasks
        ? project.tasks.filter((t) => t.completed).length
        : 0;
      const progress =
        totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
      const isCompleted = totalTasks > 0 && completedTasks === totalTasks;

      const titleElem = document.getElementById("detailProjectTitle");
      if (titleElem) titleElem.innerText = project.title;

      const breadcrumbElem = document.getElementById("breadcrumbProjectTitle");
      if (breadcrumbElem) breadcrumbElem.innerText = project.title;

      const categoryElem = document.getElementById("detailProjectCategory");
      if (categoryElem) categoryElem.innerText = project.category || "Umum";

      const descElem = document.getElementById("detailProjectDesc");
      if (descElem) descElem.innerText = project.description || "Tidak ada deskripsi projek.";

      const statusElem = document.getElementById("detailProjectStatus");
      if (statusElem) {
        if (isCompleted) {
          statusElem.className = "px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 whitespace-nowrap";
          statusElem.innerText = "Selesai";
        } else {
          statusElem.className = "px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 whitespace-nowrap";
          statusElem.innerText = "Sedang Berjalan";
        }
      }

      const progressTextElem = document.getElementById("detailProgressText");
      if (progressTextElem) progressTextElem.innerText = `${progress}% (${completedTasks}/${totalTasks})`;

      const progressBarElem = document.getElementById("detailProgressBar");
      if (progressBarElem) progressBarElem.style.width = `${progress}%`;

      const taskCountElem = document.getElementById("detailTaskCountLabel");
      if (taskCountElem) taskCountElem.innerText = `${completedTasks} dari ${totalTasks} task selesai`;

      // Live URL & Visitor Counter population
      const liveContainer = document.getElementById("detailLiveUrlContainer");
      const liveLink = document.getElementById("detailLiveUrlLink");
      const visitBtn = document.getElementById("detailVisitBtn");
      const visitorText = document.getElementById("visitorCountText");

      if (project.liveUrl) {
        const formattedUrl = formatExternalUrl(project.liveUrl);
        if (liveContainer) liveContainer.classList.remove("hidden");
        if (liveLink) {
          liveLink.href = formattedUrl;
          liveLink.innerText = project.liveUrl;
        }
        if (visitBtn) {
          visitBtn.href = formattedUrl;
          visitBtn.onclick = async () => {
            try {
              await fetch(`/api/projects/${project.id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ incrementVisitor: true }),
              });
              project.visitorCount = (project.visitorCount || 0) + 1;
              if (visitorText) visitorText.innerText = project.visitorCount;
            } catch (err) {
              console.error("Gagal mengupdate visitor hit:", err);
            }
          };
        }
        if (visitorText) visitorText.innerText = project.visitorCount || 0;
      } else {
        if (liveContainer) liveContainer.classList.add("hidden");
      }

      // Render Task List
      const tasksContainer = document.getElementById("tasksListContainer");
      const emptyState = document.getElementById("tasksEmptyState");

      if (!tasksContainer) return;
      tasksContainer.innerHTML = "";

      let filteredTasks = (project.tasks || []).filter((t) => {
        if (currentTaskFilter === "active" && t.completed) return false;
        if (currentTaskFilter === "completed" && !t.completed) return false;
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchTitle = (t.title || "").toLowerCase().includes(q);
          const matchDesc = (t.description || "").toLowerCase().includes(q);
          return matchTitle || matchDesc;
        }
        return true;
      });

      if (emptyState) {
        if (filteredTasks.length === 0) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
        } else {
          emptyState.classList.add("hidden");
          emptyState.classList.remove("flex");
        }
      }

      filteredTasks.forEach((t) => {
        const item = document.createElement("div");
        item.className =
          "p-3 sm:p-4 sm:px-5 flex items-center justify-between gap-2.5 sm:gap-4 border-l-4 border-l-transparent hover:border-l-brand-600 dark:hover:border-l-brand-400 hover:bg-slate-100/70 dark:hover:bg-slate-800/80 transition-all group cursor-pointer";

        item.innerHTML = `
          <div class="flex items-start gap-2.5 sm:gap-3.5 flex-1 min-w-0">
            <input
              type="checkbox"
              ${t.completed ? "checked" : ""}
              onchange="toggleTask('${project.id}', '${t.id}')"
              class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-brand-600 focus:ring-brand-500 mt-0.5 cursor-pointer accent-brand-600 shrink-0"
            />
            <div class="flex-1 min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white ${t.completed ? "line-through text-slate-400 dark:text-slate-500 font-normal" : ""} leading-snug">
                ${escapeHtml(t.title)}
              </h4>
              ${t.description ? `<p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 sm:mt-1 line-clamp-1 sm:line-clamp-2 font-normal">${escapeHtml(t.description)}</p>` : ""}
            </div>
          </div>

          <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
            <span class="hidden sm:inline-flex text-[10px] font-bold px-2.5 py-1 rounded-full ${
              t.completed
                ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60"
                : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            }">
              ${t.completed ? "Selesai" : "Belum Selesai"}
            </span>
            <button
              onclick="deleteTask('${project.id}', '${t.id}')"
              class="text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/50 p-1.5 sm:p-2 rounded-xl transition-all"
              title="Hapus Task"
            >
              <i class="fa-regular fa-trash-can text-xs"></i>
            </button>
          </div>
        `;

        tasksContainer.appendChild(item);
      });
    }
  
  </script>
</Layout>
