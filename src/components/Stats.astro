---
<div
  id="statsOverview"
  class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 shrink-0"
>
  <div
    class="bg-white dark:bg-slate-900 p-3.5 sm:p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between transition-colors duration-200"
  >
    <div class="min-w-0 flex-1">
      <p
        class="text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider truncate"
      >
        Total Projek
      </p>
      <h3
        class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5 sm:mt-1"
        id="statTotalProjects"
      >
        0
      </h3>
    </div>
    <div
      class="w-9 h-9 sm:w-12 sm:h-12 rounded-xl bg-brand-50 dark:bg-slate-800/80 border border-brand-100 dark:border-slate-700 text-brand-600 dark:text-brand-400 flex items-center justify-center text-sm sm:text-xl shrink-0 ml-2"
    >
      <i class="fa-solid fa-folder"></i>
    </div>
  </div>

  <div
    class="bg-white dark:bg-slate-900 p-3.5 sm:p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between transition-colors duration-200"
  >
    <div class="min-w-0 flex-1">
      <p
        class="text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider truncate"
      >
        Total Task
      </p>
      <h3
        class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5 sm:mt-1"
        id="statTotalTasks"
      >
        0
      </h3>
    </div>
    <div
      class="w-9 h-9 sm:w-12 sm:h-12 rounded-xl bg-brand-50 dark:bg-slate-800/80 border border-brand-100 dark:border-slate-700 text-brand-600 dark:text-brand-400 flex items-center justify-center text-sm sm:text-xl shrink-0 ml-2"
    >
      <i class="fa-solid fa-list-ul"></i>
    </div>
  </div>

  <div
    class="bg-white dark:bg-slate-900 p-3.5 sm:p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between transition-colors duration-200"
  >
    <div class="min-w-0 flex-1">
      <p
        class="text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider truncate"
      >
        Task Selesai
      </p>
      <h3
        class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5 sm:mt-1"
        id="statCompletedTasks"
      >
        0
      </h3>
    </div>
    <div
      class="w-9 h-9 sm:w-12 sm:h-12 rounded-xl bg-brand-50 dark:bg-slate-800/80 border border-brand-100 dark:border-slate-700 text-brand-600 dark:text-brand-400 flex items-center justify-center text-sm sm:text-xl shrink-0 ml-2"
    >
      <i class="fa-solid fa-circle-check"></i>
    </div>
  </div>

  <div
    class="bg-white dark:bg-slate-900 p-3.5 sm:p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between transition-colors duration-200"
  >
    <div class="min-w-0 flex-1">
      <p
        class="text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider truncate"
      >
        Rata-Rata Progres
      </p>
      <h3
        class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5 sm:mt-1"
        id="statAvgProgress"
      >
        0%
      </h3>
    </div>
    <div
      class="w-9 h-9 sm:w-12 sm:h-12 rounded-xl bg-brand-50 dark:bg-slate-800/80 border border-brand-100 dark:border-slate-700 text-brand-600 dark:text-brand-400 flex items-center justify-center text-sm sm:text-xl shrink-0 ml-2"
    >
      <i class="fa-solid fa-chart-line"></i>
    </div>
  </div>
</div>
