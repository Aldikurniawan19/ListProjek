    async function trackWebHit(projectId) {
      try {
        await fetch(`/api/projects/${projectId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ incrementVisitor: true }),
        });
        const p = projects.find(item => item.id === projectId);
        if (p) p.visitorCount = (p.visitorCount || 0) + 1;
        renderDeployedTable();
      } catch (err) {
        console.error("Gagal meng-increment visitor count:", err);
      }
    }

    async function deleteProject(projectId, event) {
      if (event) event.stopPropagation();
      const project = projects.find((p) => p.id === projectId);
      const title = project
        ? `Hapus Projek "${project.title}"?`
        : "Hapus Projek Ini?";

      Ghostoast.confirm({
        title: title,
        message:
          "Projek ini beserta seluruh sub-task di dalamnya akan dihapus secara permanen.",
        confirmText: "Ya, Hapus Projek",
        onConfirm: async () => {
          try {
            await api(`/api/projects/${projectId}`, { method: "DELETE" });
            projects = projects.filter((p) => p.id !== projectId);
            Ghostoast.success(
              "Projek beserta seluruh tasknya telah dihapus.",
              "Projek Dihapus",
            );
            if (activeProjectId === projectId) {
              showDashboardView();
            } else {
              renderDashboard();
              renderDeployedTable();
            }
          } catch (err) {
            console.error("Gagal menghapus projek:", err);
            Ghostoast.error("Gagal menghapus projek.", "Terjadi Kesalahan");
          }
        },
      });
    }

    function deleteActiveProject() {
      if (activeProjectId) {
        deleteProject(activeProjectId, null);
      }
    }

