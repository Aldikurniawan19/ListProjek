					<td class="px-4 py-3 whitespace-nowrap text-slate-600 dark:text-slate-400 text-xs font-medium">
						<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-slate-100/80 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 text-[11px]">
							<i class="fa-regular fa-calendar-check text-brand-500"></i> ${formatDate(p.createdAt)}
						</span>
					</td>
					<td class="px-4 py-3 whitespace-nowrap text-center">
						<div class="flex items-center justify-center gap-1.5">
							<button onclick="event.stopPropagation(); showProjectDetailView('${p.id}')" class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 rounded-lg text-[11px] font-semibold transition-all border border-slate-200 dark:border-slate-700 flex items-center gap-1">
								<span>Buka Task</span>
								<i class="fa-solid fa-chevron-right text-[9px]"></i>
							</button>
							<button onclick="deleteProject('${p.id}', event)" title="Hapus Projek" class="text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-1 rounded-lg transition-colors">
								<i class="fa-regular fa-trash-can text-xs"></i>
							</button>
						</div>
					</td>
				`;

        if (tbody) tbody.appendChild(tr);

        if (mobileList) {
          const card = document.createElement("div");
          card.className = "p-3.5 bg-white dark:bg-slate-900 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors flex flex-col gap-2";
          card.onclick = () => showProjectDetailView(p.id);
          card.innerHTML = `
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="text-xs font-bold text-slate-900 dark:text-white truncate">${escapeHtml(p.title)}</span>
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">${escapeHtml(p.category)}</span>
                  ${p.liveUrl ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">Deployed</span>` : ''}
                </div>
                ${p.description ? `<p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-1 font-normal">${escapeHtml(p.description)}</p>` : ''}
              </div>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${isCompleted ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700'}">
                ${isCompleted ? 'Selesai' : 'Sedang Berjalan'}
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px]">
              <div class="flex items-center gap-2 flex-1 min-w-0">
                <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700 flex-1">
                  <div class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: ${progress}%"></div>
                </div>
                <span class="font-bold text-brand-600 dark:text-brand-400 text-[10px] shrink-0">${progress}%</span>
              </div>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium shrink-0">
                <i class="fa-regular fa-check-square mr-1 text-brand-500"></i>${completedTasks}/${totalTasks}
              </span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium shrink-0 flex items-center gap-1">
                <i class="fa-regular fa-calendar-days text-slate-400"></i>${formatDate(p.createdAt)}
              </span>
              <button onclick="deleteProject('${p.id}', event)" title="Hapus Projek" class="text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-1 rounded-lg transition-colors shrink-0">
                <i class="fa-regular fa-trash-can text-xs"></i>
              </button>
            </div>
          `;
          mobileList.appendChild(card);
        }
      });

      renderPagination(
        "projectPaginationContainer",
        "projectPaginationInfo",
        "projectPaginationControls",
        totalItems,
        projectCurrentPage,
        projectPageSize,
        "setProjectPage",
        "projek"
      );
    }

    async function quickAddTask(e) {
      e.preventDefault();
      if (!activeProjectId) return;
      const input = document.getElementById("quickTaskInput");
      const title = input ? input.value.trim() : "";
      if (!title) return;

      try {
        const task = await api(`/api/projects/${activeProjectId}/tasks`, {
          method: "POST",
          body: JSON.stringify({ title, description: "" }),
        });
        const project = projects.find((p) => p.id === activeProjectId);
        if (project) project.tasks.push(task);
        if (input) input.value = "";
        renderDashboard();
      } catch (err) {
        console.error("Gagal menyimpan task:", err);
        alert("Gagal menyimpan task.");
      }
    }

    function renderTaskDetailView() {
      const project = projects.find((p) => p.id === activeProjectId);
      if (!project) {
        showDashboardView();
        return;
      }

      const totalTasks = project.tasks ? project.tasks.length : 0;
      const completedTasks = project.tasks
        ? project.tasks.filter((t) => t.completed).length
        : 0;
      const progress =
        totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
      const isCompleted = totalTasks > 0 && completedTasks === totalTasks;

      const titleElem = document.getElementById("detailProjectTitle");
      if (titleElem) titleElem.innerText = project.title;

      const breadcrumbElem = document.getElementById("breadcrumbProjectTitle");
      if (breadcrumbElem) breadcrumbElem.innerText = project.title;

      const categoryElem = document.getElementById("detailProjectCategory");
      if (categoryElem) categoryElem.innerText = project.category || "Umum";

      const descElem = document.getElementById("detailProjectDesc");
      if (descElem) descElem.innerText = project.description || "Tidak ada deskripsi projek.";

      const statusElem = document.getElementById("detailProjectStatus");
      if (statusElem) {
        if (isCompleted) {
          statusElem.className = "px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 whitespace-nowrap";
          statusElem.innerText = "Selesai";
        } else {
          statusElem.className = "px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 whitespace-nowrap";
          statusElem.innerText = "Sedang Berjalan";
        }
      }

      const progressTextElem = document.getElementById("detailProgressText");
      if (progressTextElem) progressTextElem.innerText = `${progress}% (${completedTasks}/${totalTasks})`;

      const progressBarElem = document.getElementById("detailProgressBar");
      if (progressBarElem) progressBarElem.style.width = `${progress}%`;

      const taskCountElem = document.getElementById("detailTaskCountLabel");
      if (taskCountElem) taskCountElem.innerText = `${completedTasks} dari ${totalTasks} task selesai`;

      // Live URL & Visitor Counter population
      const liveContainer = document.getElementById("detailLiveUrlContainer");
      const liveLink = document.getElementById("detailLiveUrlLink");
      const visitBtn = document.getElementById("detailVisitBtn");
      const visitorText = document.getElementById("visitorCountText");

      if (project.liveUrl) {
        const formattedUrl = formatExternalUrl(project.liveUrl);
        if (liveContainer) liveContainer.classList.remove("hidden");
        if (liveLink) {
          liveLink.href = formattedUrl;
          liveLink.innerText = project.liveUrl;
        }
        if (visitBtn) {
          visitBtn.href = formattedUrl;
          visitBtn.onclick = async () => {
            try {
              await fetch(`/api/projects/${project.id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ incrementVisitor: true }),
              });
              project.visitorCount = (project.visitorCount || 0) + 1;
              if (visitorText) visitorText.innerText = project.visitorCount;
            } catch (err) {
              console.error("Gagal mengupdate visitor hit:", err);
            }
          };
        }
        if (visitorText) visitorText.innerText = project.visitorCount || 0;
      } else {
        if (liveContainer) liveContainer.classList.add("hidden");
      }

      // Render Task List (Tree View with Pagination)
      const tasksContainer = document.getElementById("tasksListContainer");
      const emptyState = document.getElementById("tasksEmptyState");

      if (!tasksContainer) return;
      tasksContainer.innerHTML = "";

      const rawTree = buildTaskTree(project.tasks || []);
      const filteredTree = filterTaskTree(rawTree, currentTaskFilter, searchQuery);

      const totalItems = filteredTree.length;
      const totalPages = Math.ceil(totalItems / taskPageSize) || 1;
      if (taskCurrentPage > totalPages) taskCurrentPage = totalPages;
      if (taskCurrentPage < 1) taskCurrentPage = 1;

      const startIndex = (taskCurrentPage - 1) * taskPageSize;
      const pagedTree = filteredTree.slice(startIndex, startIndex + taskPageSize);

      if (emptyState) {
        if (totalItems === 0) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
        } else {
          emptyState.classList.add("hidden");
          emptyState.classList.remove("flex");
        }
      }

      pagedTree.forEach((rootTask) => {
        renderTaskTreeItem(rootTask, project, tasksContainer, 0);
      });

      renderPagination(
        "taskPaginationContainer",
        "taskPaginationInfo",
        "taskPaginationControls",
        totalItems,
        taskCurrentPage,
        taskPageSize,
        "setTaskPage",
        "task"
      );
    }

    // Books Library Client Logic
    let booksData = [];

    async function fetchBooks() {
      const booksGrid = document.getElementById("booksGrid");
      const emptyState = document.getElementById("booksEmptyState");
      const countBadge = document.getElementById("booksCountBadge");

      try {
        if (booksGrid && booksData.length === 0) {
          booksGrid.innerHTML = `
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 space-y-3 animate-pulse col-span-full max-w-sm">
              <div class="w-full h-36 bg-slate-200 dark:bg-slate-800 rounded-xl"></div>
              <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-3/4"></div>
              <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-1/2"></div>
            </div>
          `;
        }

        const res = await fetch("/api/books");
        if (!res.ok) throw new Error("Gagal mengambil daftar buku");
        booksData = await res.json();

        if (countBadge) {
          countBadge.innerText = `${booksData.length} Buku`;
        }

        renderBooks(booksData);
      } catch (err) {
        console.error("Error fetching books:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal mengambil data buku dari Supabase");
        }
      }
    }
    window.fetchBooks = fetchBooks;

    function handleBookSearch() {
      const query = (document.getElementById("bookSearchInput")?.value || "").toLowerCase().trim();
      if (!query) {
        renderBooks(booksData);
        return;
      }
      const filtered = booksData.filter(b =>
        (b.title || "").toLowerCase().includes(query) ||
        (b.author || "").toLowerCase().includes(query) ||
        (b.description || "").toLowerCase().includes(query)
      );
      renderBooks(filtered);
    }
    window.handleBookSearch = handleBookSearch;

    function renderBooks(books) {
      const booksGrid = document.getElementById("booksGrid");
      const emptyState = document.getElementById("booksEmptyState");

      if (!booksGrid || !emptyState) return;

      if (!books || books.length === 0) {
        booksGrid.innerHTML = "";
        booksGrid.classList.add("hidden");
        emptyState.classList.remove("hidden");
        emptyState.classList.add("flex");
        return;
      }

      emptyState.classList.add("hidden");
      emptyState.classList.remove("flex");
      booksGrid.classList.remove("hidden");

      const gradients = [
        "from-indigo-600 via-purple-600 to-pink-600",
        "from-blue-600 via-teal-600 to-emerald-600",
        "from-rose-600 via-red-600 to-amber-600",
        "from-violet-600 via-indigo-600 to-blue-600",
        "from-emerald-600 via-cyan-600 to-indigo-600",
      ];

      booksGrid.innerHTML = books.map((book, idx) => {
        const gradient = gradients[idx % gradients.length];
        const formattedSize = book.file_size ? formatBytes(book.file_size) : 'PDF';
        const formattedDate = book.created_at ? new Date(book.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
        const safeTitle = (book.title || 'Tanpa Judul').replace(/'/g, "\\'").replace(/"/g, '&quot;');
        const safeAuthor = (book.author || 'Anonim').replace(/'/g, "\\'").replace(/"/g, '&quot;');

        return `
          <div class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 hover:border-brand-500/50 dark:hover:border-brand-500/50 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden">
            <!-- Book Cover Top Banner -->
            <div class="relative h-40 bg-gradient-to-tr ${gradient} p-5 flex flex-col justify-between text-white overflow-hidden shrink-0">
              <!-- Background Deco Overlay -->
              <div class="absolute -right-4 -bottom-4 text-white/10 text-8xl font-black select-none pointer-events-none group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-book"></i>
              </div>
              
              <div class="flex items-center justify-between gap-2 z-10">
                <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/20 backdrop-blur-md text-white border border-white/20 flex items-center gap-1 shadow-xs">
                  <i class="fa-solid fa-file-pdf"></i> ${formattedSize}
                </span>
                <button
                  onclick="deleteBook('${book.id}', '${safeTitle}')"
                  title="Hapus Buku"
                  class="w-7 h-7 rounded-lg bg-black/20 hover:bg-rose-600 text-white/80 hover:text-white backdrop-blur-md transition-all flex items-center justify-center text-xs cursor-pointer"
                >
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </div>

              <div class="z-10 mt-auto">
                <span class="text-[10px] font-medium text-white/80 uppercase tracking-wider block">Buku Digital</span>
                <h4 class="font-bold text-base leading-tight text-white line-clamp-2 drop-shadow-xs" title="${safeTitle}">
                  ${escapeHtml(book.title || 'Tanpa Judul')}
                </h4>
              </div>
            </div>

            <!-- Book Card Body -->
            <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1.5">
                <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-medium">
                  <i class="fa-solid fa-user-pen text-[11px] text-brand-500"></i>
                  <span class="truncate" title="${safeAuthor}">${escapeHtml(book.author || 'Penulis Tidak Diketahui')}</span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                  ${escapeHtml(book.description || 'Tidak ada deskripsi singkat untuk buku ini.')}
                </p>
              </div>

              <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
                <span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium">
                  ${formattedDate}
                </span>
                <div class="flex items-center gap-1.5">
                  <a
                    href="${book.file_url}"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Buka File di Tab Baru"
                    class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center text-xs transition-all cursor-pointer"
                  >
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                  <button
                    onclick="openBookReaderModal('${book.file_url}', '${safeTitle}', '${safeAuthor}')"
                    class="px-3 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold transition-all shadow-xs flex items-center gap-1.5 cursor-pointer"
                  >
                    <i class="fa-solid fa-book-open text-[11px]"></i>
                    <span>Baca Buku</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }
    window.renderBooks = renderBooks;

    async function deleteBook(id, title) {
      if (!confirm(`Apakah Anda yakin ingin menghapus buku "${title}" dari database dan storage?`)) {
        return;
      }

      try {
        if (window.showLoadingScreen) {
          window.showLoadingScreen("Menghapus Buku", `Sedang menghapus "${title}"...`);
        }

        const res = await fetch(`/api/books?id=${id}`, {
          method: "DELETE",
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Gagal menghapus buku");

        if (window.Ghostoast) {
          Ghostoast.success(`Buku "${title}" berhasil dihapus`, "Terhapus");
        }

        fetchBooks();
      } catch (err) {
        console.error("Error deleting book:", err);
        if (window.Ghostoast) {
          Ghostoast.error(err.message || "Gagal menghapus buku");
        }
      } finally {
        if (window.hideLoadingScreen) {
          window.hideLoadingScreen();
        }
      }
    }
    window.deleteBook = deleteBook;
  </script>
</Layout>
