---
---

<div
  id="loadingScreen"
  class="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-slate-950/65 dark:bg-slate-950/85 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 ease-out"
  aria-hidden="true"
  role="dialog"
  aria-label="Loading"
>
  <div
    id="loadingCard"
    class="relative w-full max-w-xs sm:max-w-sm bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl shadow-2xl p-7 text-center flex flex-col items-center justify-center space-y-6 transform scale-90 transition-all duration-300 ease-out backdrop-blur-2xl overflow-hidden"
  >
    <!-- Ambient Holographic Glow Effects -->
    <div class="absolute -top-16 -right-16 w-36 h-36 bg-gradient-to-br from-brand-500/25 to-indigo-600/30 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-16 -left-16 w-36 h-36 bg-gradient-to-tr from-purple-500/25 to-pink-500/25 rounded-full blur-3xl pointer-events-none animate-pulse" style="animation-delay: 1s;"></div>

    <!-- SIGNATURE ANIMATION CONTAINER -->
    <div class="relative w-28 h-28 flex items-center justify-center py-2 select-none">
      
      <!-- 3D Orbiting Laser Ring -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none" style="perspective: 600px;">
        <div class="w-24 h-24 rounded-full border-[2.5px] border-transparent border-t-brand-500 border-r-indigo-500 dark:border-t-brand-400 dark:border-r-indigo-400 animate-laser-orbit filter drop-shadow-[0_0_8px_rgba(59,130,246,0.6)]"></div>
        <div class="absolute w-20 h-20 rounded-full border-[1.5px] border-transparent border-b-purple-500 border-l-pink-500 animate-laser-orbit-reverse filter drop-shadow-[0_0_6px_rgba(168,85,247,0.5)]"></div>
      </div>

      <!-- 3D Stacked Kinetic Task Cards -->
      <div class="relative w-20 h-20 flex items-center justify-center">
        <!-- Back Card 3 (Furthest) -->
        <div class="absolute w-14 h-12 rounded-xl bg-slate-200/60 dark:bg-slate-800/60 border border-slate-300/40 dark:border-slate-700/40 transform -translate-y-4 scale-75 opacity-40 shadow-sm transition-transform animate-card-float-back"></div>
        
        <!-- Back Card 2 (Middle) -->
        <div class="absolute w-15 h-13 rounded-xl bg-slate-100/80 dark:bg-slate-800/80 border border-slate-300/60 dark:border-slate-700/60 transform -translate-y-2 scale-85 opacity-70 shadow-md transition-transform animate-card-float-mid"></div>

        <!-- Front Main Task Card -->
        <div class="relative w-16 h-14 rounded-2xl bg-gradient-to-b from-white to-slate-50 dark:from-slate-800 dark:to-slate-900 border border-slate-200 dark:border-slate-700/90 shadow-xl shadow-brand-500/10 dark:shadow-brand-500/20 p-2.5 flex flex-col justify-between transform transition-transform animate-card-float-front">
          <!-- Card Top Bar: Status pill & Task indicator -->
          <div class="flex items-center justify-between gap-1">
            <div class="h-1.5 w-6 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden relative">
              <div class="absolute inset-0 bg-gradient-to-r from-brand-500 to-indigo-500 animate-shimmer-fast"></div>
            </div>
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/30 border border-emerald-500 flex items-center justify-center">
              <div class="w-1 h-1 rounded-full bg-emerald-500 animate-ping"></div>
            </div>
          </div>

          <!-- Card Content: Dynamic Task Items with Checkmark -->
          <div class="flex items-center justify-between gap-2 mt-1">
            <div class="flex-1 space-y-1">
              <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden relative">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-500 animate-shimmer-slow"></div>
              </div>
              <div class="h-1.5 w-2/3 rounded-full bg-slate-100 dark:bg-slate-800"></div>
            </div>

            <!-- Signature Interactive Animated Checkmark Box -->
            <div class="w-6 h-6 rounded-lg bg-gradient-to-tr from-brand-600 via-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-md shadow-brand-500/30 shrink-0 transform hover:scale-105 transition-transform">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                <path class="animate-svg-check" d="M20 6L9 17l-5-5"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Floating Particles Badge -->
        <div class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-amber-400 text-amber-950 font-extrabold text-[9px] flex items-center justify-center shadow-lg shadow-amber-400/40 animate-bounce-gentle">
          <i class="fa-solid fa-sparkles text-[8px]"></i>
        </div>
      </div>
    </div>

    <!-- DYNAMIC TYPOGRAPHY & SUBTITLE -->
    <div class="space-y-1.5 z-10">
      <h3
        id="loadingTitle"
        class="text-base sm:text-lg font-extrabold tracking-tight leading-snug bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 dark:from-brand-400 dark:via-indigo-300 dark:to-purple-400 bg-clip-text text-transparent"
      >
        Memproses...
      </h3>
      
      <div class="flex items-center justify-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span id="loadingSubtitle">Mohon tunggu sebentar</span>
        <!-- Kinetic Typing Dots -->
        <span class="inline-flex items-center gap-0.5 ml-0.5">
          <span class="w-1 h-1 rounded-full bg-brand-500 animate-pulse-dot-1"></span>
          <span class="w-1 h-1 rounded-full bg-indigo-500 animate-pulse-dot-2"></span>
          <span class="w-1 h-1 rounded-full bg-purple-500 animate-pulse-dot-3"></span>
        </span>
      </div>
    </div>

    <!-- BOTTOM LASER SLIDER -->
    <div class="w-full bg-slate-100 dark:bg-slate-800/80 h-1.5 rounded-full overflow-hidden relative mt-1">
      <div class="loading-laser-beam h-full bg-gradient-to-r from-brand-500 via-indigo-500 to-purple-500 rounded-full shadow-[0_0_10px_rgba(99,102,241,0.8)]"></div>
    </div>
  </div>
</div>

<style is:global>
  /* 3D Orbit Ring Animations */
  @keyframes laserOrbit {
    0% { transform: rotateX(60deg) rotateZ(0deg); }
    100% { transform: rotateX(60deg) rotateZ(360deg); }
  }

  @keyframes laserOrbitReverse {
    0% { transform: rotateX(60deg) rotateZ(360deg); }
    100% { transform: rotateX(60deg) rotateZ(0deg); }
  }

  .animate-laser-orbit {
    animation: laserOrbit 2s linear infinite;
  }

  .animate-laser-orbit-reverse {
    animation: laserOrbitReverse 2.8s linear infinite;
  }

  /* 3D Stacked Floating Card Animations */
  @keyframes cardFloatFront {
    0%, 100% { transform: translateY(0px) scale(1) rotate(0deg); }
    50% { transform: translateY(-5px) scale(1.02) rotate(-1deg); }
  }

  @keyframes cardFloatMid {
    0%, 100% { transform: translateY(-8px) scale(0.88) rotate(0deg); opacity: 0.7; }
    50% { transform: translateY(-11px) scale(0.9) rotate(2deg); opacity: 0.85; }
  }

  @keyframes cardFloatBack {
    0%, 100% { transform: translateY(-16px) scale(0.76) rotate(0deg); opacity: 0.4; }
    50% { transform: translateY(-19px) scale(0.78) rotate(-2deg); opacity: 0.6; }
  }

  .animate-card-float-front {
    animation: cardFloatFront 2.6s ease-in-out infinite;
  }

  .animate-card-float-mid {
    animation: cardFloatMid 2.6s ease-in-out infinite;
  }

  .animate-card-float-back {
    animation: cardFloatBack 2.6s ease-in-out infinite;
  }

  /* Animated Checkmark Drawing Path */
  @keyframes svgCheckDraw {
    0% {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      opacity: 0.2;
    }
    40%, 80% {
      stroke-dasharray: 30;
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dasharray: 30;
      stroke-dashoffset: -30;
      opacity: 0.2;
    }
  }

  .animate-svg-check {
    stroke-dasharray: 30;
    stroke-dashoffset: 0;
    animation: svgCheckDraw 2.4s ease-in-out infinite;
  }

  /* Shimmers & Laser Slider */
  @keyframes shimmerFast {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .animate-shimmer-fast {
    animation: shimmerFast 1.2s infinite ease-in-out;
  }

  .animate-shimmer-slow {
    animation: shimmerFast 1.8s infinite ease-in-out;
  }

  @keyframes bounceGentle {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-4px) scale(1.1); }
  }

  .animate-bounce-gentle {
    animation: bounceGentle 2s ease-in-out infinite;
  }

  @keyframes laserMove {
    0% { left: -40%; width: 40%; }
    50% { left: 30%; width: 55%; }
    100% { left: 100%; width: 40%; }
  }

  .loading-laser-beam {
    position: absolute;
    animation: laserMove 1.6s infinite ease-in-out;
  }

  /* Kinetic Typing Dots */
  @keyframes pulseDot {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .animate-pulse-dot-1 { animation: pulseDot 1.4s infinite ease-in-out 0s; }
  .animate-pulse-dot-2 { animation: pulseDot 1.4s infinite ease-in-out 0.2s; }
  .animate-pulse-dot-3 { animation: pulseDot 1.4s infinite ease-in-out 0.4s; }
</style>

<script is:inline>
  (function () {
    const LoadingScreen = {
      show: function (title = 'Memproses...', subtitle = 'Mohon tunggu sebentar') {
        const el = document.getElementById('loadingScreen');
        const card = document.getElementById('loadingCard');
        const titleEl = document.getElementById('loadingTitle');
        const subtitleEl = document.getElementById('loadingSubtitle');

        if (titleEl) titleEl.innerText = title;
        if (subtitleEl) subtitleEl.innerText = subtitle;

        if (el && card) {
          el.classList.remove('pointer-events-none', 'opacity-0');
          el.classList.add('opacity-100');
          card.classList.remove('scale-90');
          card.classList.add('scale-100');
          el.setAttribute('aria-hidden', 'false');
        }
      },

      hide: function () {
        const el = document.getElementById('loadingScreen');
        const card = document.getElementById('loadingCard');

        if (el && card) {
          el.classList.remove('opacity-100');
          el.classList.add('opacity-0', 'pointer-events-none');
          card.classList.remove('scale-100');
          card.classList.add('scale-90');
          el.setAttribute('aria-hidden', 'true');
        }
      },

      updateText: function (title, subtitle) {
        const titleEl = document.getElementById('loadingTitle');
        const subtitleEl = document.getElementById('loadingSubtitle');
        if (title && titleEl) titleEl.innerText = title;
        if (subtitle && subtitleEl) subtitleEl.innerText = subtitle;
      }
    };

    window.LoadingScreen = LoadingScreen;
    window.showLoadingScreen = LoadingScreen.show;
    window.hideLoadingScreen = LoadingScreen.hide;
    window.updateLoadingText = LoadingScreen.updateText;
  })();
</script>
