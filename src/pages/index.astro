---
import Layout from '~/layouts/Layout.astro';
import Sidebar from '~/components/Sidebar.astro';
import Header from '~/components/Header.astro';
import Stats from '~/components/Stats.astro';
import Dashboard from './dashboard/index.astro';
import ProjectDetail from './projects/detail.astro';
import Calendar from './calendar/index.astro';
import ProjectModal from '~/components/ProjectModal.astro';
import TaskModal from '~/components/TaskModal.astro';
import EventModal from '~/components/EventModal.astro';
import Toast from '~/components/Toast.astro';
import { supabase } from '~/lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

if (!accessToken || !refreshToken) {
  return Astro.redirect('/auth/login');
}

const { data, error } = await supabase.auth.setSession({
  refresh_token: refreshToken.value,
  access_token: accessToken.value,
});

if (error) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/auth/login');
}

const user = data.user;
---
<Layout>
  <Sidebar user={user} />
  <div class="flex-1 flex flex-col min-w-0 h-screen md:ml-64 overflow-hidden">
    <Header />
    <main
      id="mainContent"
      class="flex-1 p-4 md:p-6 overflow-hidden flex flex-col min-h-0 space-y-4"
    >
      <Stats />
      <Dashboard />
      <ProjectDetail />
      <Calendar />
    </main>
  </div>
  <ProjectModal />
  <TaskModal />
  <EventModal />
  <Toast />
  <script is:inline src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <script is:inline>
    // Simplified router and state management
    let projects = [];
    let activeProjectId = null;
    let currentFilter = "all";
    let currentTaskFilter = "all";
    let searchQuery = "";
    let calendar;

    document.addEventListener("DOMContentLoaded", () => {
      showDashboardView();
      fetchProjects();
      updateThemeIcon();

      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has("login") && window.Ghostoast) {
        Ghostoast.success("Selamat datang kembali di dashboard Anda!", "Login Berhasil");
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    });

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateThemeIcon();
      if (window.Ghostoast) {
        Ghostoast.info(
          `Berhasil berpindah ke Mode ${isDark ? "Gelap (Dark)" : "Terang (Light)"}.`,
          "Tema Diperbarui"
        );
      }
    }

    function updateThemeIcon() {
      const knob = document.getElementById("themeToggleKnob");
      const knobIcon = document.getElementById("themeToggleKnobIcon");
      if (knob && knobIcon) {
        const isDark = document.documentElement.classList.contains("dark");
        if (isDark) {
          knob.classList.add("translate-x-7");
          knobIcon.className = "fa-solid fa-moon text-[10px] text-indigo-400";
        } else {
          knob.classList.remove("translate-x-7");
          knobIcon.className = "fa-solid fa-sun text-[10px] text-amber-500";
        }
      }
    }

    async function fetchProjects() {
      try {
        const res = await fetch("/api/projects");
        projects = await res.json();
        renderDashboard();
      } catch (err) {
        console.error("Gagal mengambil data projek:", err);
      }
    }

    function updateSidebarNav(activeNavId) {
      const navBtns = [
        { id: "navProjectBtn", defaultIconClass: "fa-solid fa-folder-open text-slate-400 dark:text-slate-500 w-5 text-center", activeIconClass: "fa-solid fa-folder-open text-white w-5 text-center" },
        { id: "navCalendarBtn", defaultIconClass: "fa-solid fa-calendar-days text-slate-400 dark:text-slate-500 w-5 text-center", activeIconClass: "fa-solid fa-calendar-days text-white w-5 text-center" }
      ];

      navBtns.forEach(nav => {
        const btn = document.getElementById(nav.id);
        if (btn) {
          const icon = btn.querySelector("i");
          if (nav.id === activeNavId) {
            btn.className = "w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-brand-600 text-white font-semibold text-sm shadow-md shadow-brand-500/25 transition-all text-left";
            if (icon) icon.className = nav.activeIconClass;
          } else {
            btn.className = "w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white font-medium text-sm transition-all text-left";
            if (icon) icon.className = nav.defaultIconClass;
          }
        }
      });
    }

    function showView(viewId) {
      document.getElementById("listView").style.display = "none";
      document.getElementById("detailView").style.display = "none";
      document.getElementById("calendarView").style.display = "none";
      document.getElementById(viewId).style.display = "flex";
    }

    function showDashboardView() {
      updateSidebarNav("navProjectBtn");
      activeProjectId = null;
      showView("listView");
      document.getElementById("statsOverview").style.display = "grid";
      document.getElementById("viewTitle").innerText = "Daftar Projek Utama";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "flex";
      renderDashboard();
    }

    function showProjectDetailView(id) {
      updateSidebarNav("navProjectBtn");
      activeProjectId = id;
      showView("detailView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Detail Task Projek";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "none";
      renderDashboard();
    }

    let currentMockupTheme = 'blue';

    const themeGradients = {
      blue: 'from-brand-600 via-indigo-600 to-violet-700',
      purple: 'from-purple-600 via-fuchsia-600 to-pink-700',
      emerald: 'from-emerald-600 via-teal-600 to-cyan-700',
      rose: 'from-rose-600 via-red-600 to-orange-700',
      amber: 'from-amber-500 via-orange-600 to-yellow-600',
    };

    const themeSolidColors = {
      blue: '#2563eb',
      purple: '#9333ea',
      emerald: '#059669',
      rose: '#e11d48',
      amber: '#d97706',
    };

    function setMockupTheme(theme) {
      currentMockupTheme = theme;
      const banner = document.getElementById("mockupCardBanner");
      if (banner && themeGradients[theme]) {
        banner.className = `bg-gradient-to-br ${themeGradients[theme]} p-6 text-white relative overflow-hidden transition-all duration-300`;
      }

      document.querySelectorAll(".color-theme-btn").forEach((btn) => {
        const icon = btn.querySelector(".theme-check-icon");
        if (btn.dataset.theme === theme) {
          if (icon) icon.classList.remove("hidden");
          btn.classList.add("ring-2", "ring-brand-500", "ring-offset-2", "dark:ring-offset-slate-900", "scale-110");
        } else {
          if (icon) icon.classList.add("hidden");
          btn.classList.remove("ring-2", "ring-brand-500", "ring-offset-2", "dark:ring-offset-slate-900", "scale-110");
        }
      });
    }

    async function fetchEvents() {
      try {
        const res = await fetch("/api/events");
        if (!res.ok) throw new Error("Gagal mengambil data acara");
        const data = await res.json();
        
        const countBadge = document.getElementById("eventCountBadge");
        if (countBadge) countBadge.innerText = `${data.length} Acara`;

        return data.map(e => {
          const colorKey = e.color || 'blue';
          const bgColor = themeSolidColors[colorKey] || themeSolidColors.blue;
          return {
            id: e.id,
            title: e.title,
            start: e.start,
            end: e.end,
            allDay: true,
            backgroundColor: bgColor,
            borderColor: 'transparent',
            extendedProps: { color: colorKey }
          };
        });
      } catch (err) {
        console.error("Gagal mengambil data events:", err);
        return [];
      }
    }

    const themeGradientsMap = {
      blue: 'linear-gradient(135deg, #2563eb, #4f46e5)',
      purple: 'linear-gradient(135deg, #9333ea, #c026d3)',
      emerald: 'linear-gradient(135deg, #059669, #0d9488)',
      rose: 'linear-gradient(135deg, #e11d48, #ea580c)',
      amber: 'linear-gradient(135deg, #d97706, #ca8a04)',
    };

    async function showCalendarView() {
      updateSidebarNav("navCalendarBtn");
      showView("calendarView");
      document.getElementById("statsOverview").style.display = "none";
      document.getElementById("viewTitle").innerText = "Kalender & Jadwal";
      const mainBtn = document.getElementById("mainActionBtn");
      if (mainBtn) mainBtn.style.display = "none";
      const events = await fetchEvents();
      if (calendar) {
        calendar.removeAllEvents();
        calendar.addEventSource(events);
      } else {
        initCalendar(events);
      }
    }
    
    function renderDashboard() {
      updateStats();
      if (activeProjectId) {
        renderTaskDetailView();
      } else {
        renderProjectsTableView();
      }
    }

    async function api(url, options = {}) {
      const res = await fetch(url, {
        headers: { "Content-Type": "application/json" },
        ...options,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Request failed");
      return data;
    }

    function toggleSidebar() {
      const sidebar = document.getElementById("sidebar");
      const overlay = document.getElementById("sidebarOverlay");
      sidebar.classList.toggle("-translate-x-full");
      overlay.classList.toggle("hidden");
    }

    function openModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('hidden');
        setTimeout(() => modal.classList.add('open'), 10);
      }
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('open');
        setTimeout(() => {
          modal.classList.add('hidden');
          if (modalId === "projectModal") document.getElementById("projectForm").reset();
          if (modalId === "taskModal") document.getElementById("taskForm").reset();
        }, 300);
      }
    }

    function openEventModal(selectedDate = "") {
      const modal = document.getElementById("eventModal");
      if (!modal) return;
      
      const form = document.getElementById("eventForm");
      if (form) form.reset();
      
      setMockupTheme('blue');
      const todayStr = selectedDate || new Date().toISOString().split("T")[0];
      const startDateInput = document.getElementById("eventStartDate");
      if (startDateInput) startDateInput.value = todayStr;
      
      updateMockupPreview();

      modal.classList.remove("hidden", "mockup-closing");
      setTimeout(() => modal.classList.add("open"), 10);
    }

    function closeEventModal() {
      const modal = document.getElementById("eventModal");
      if (!modal) return;

      modal.classList.remove("open");
      modal.classList.add("mockup-closing");

      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("mockup-closing");
        const form = document.getElementById("eventForm");
        if (form) form.reset();
      }, 450);
    }

    function updateMockupPreview() {
      const titleInput = document.getElementById("eventTitle");
      const startDateInput = document.getElementById("eventStartDate");
      const endDateInput = document.getElementById("eventEndDate");
      
      const mockupTitle = document.getElementById("eventMockupTitle");
      const mockupDate = document.getElementById("eventMockupDate");

      const titleVal = titleInput?.value.trim() || "Judul Acara Baru";
      const startVal = startDateInput?.value ? new Date(startDateInput.value).toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' }) : "Pilih tanggal...";
      const endVal = endDateInput?.value ? " - " + new Date(endDateInput.value).toLocaleDateString("id-ID", { day: 'numeric', month: 'short', year: 'numeric' }) : "";

      if (mockupTitle) mockupTitle.innerText = titleVal;
      if (mockupDate) mockupDate.innerHTML = `<i class="fa-regular fa-clock"></i> ${startVal}${endVal}`;
    }

    async function saveEvent(e) {
      if (e) e.preventDefault();
      
      const title = document.getElementById("eventTitle")?.value.trim();
      const start = document.getElementById("eventStartDate")?.value;
      const end = document.getElementById("eventEndDate")?.value || null;

      if (!title || !start) {
        if (window.Ghostoast) Ghostoast.error("Judul dan tanggal mulai wajib diisi", "Form Tidak Lengkap");
        return;
      }

      const saveBtn = document.getElementById("saveEventBtn");
      const saveBtnText = document.getElementById("saveEventBtnText");
      if (saveBtn) saveBtn.disabled = true;
      if (saveBtnText) saveBtnText.innerText = "Menyimpan...";

      try {
        const newEvent = await api("/api/events", {
          method: "POST",
          body: JSON.stringify({ title, start, end, color: currentMockupTheme }),
        });

        // Instantly refresh all events from DB into calendar
        const eventsList = await fetchEvents();
        if (calendar) {
          calendar.removeAllEvents();
          calendar.addEventSource(eventsList);
        }

        closeEventModal();
        if (window.Ghostoast) {
          Ghostoast.success(
            `Acara "${title}" tersimpan di database.`,
            "Acara Berhasil Dibuat"
          );
        }
      } catch (err) {
        console.error("Gagal menyimpan acara:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menyimpan acara ke database.", "Terjadi Kesalahan");
        }
      } finally {
        if (saveBtn) saveBtn.disabled = false;
        if (saveBtnText) saveBtnText.innerText = "Simpan Acara";
      }
    }

    async function deleteEvent(eventId) {
      try {
        await api(`/api/events/${eventId}`, { method: "DELETE" });
        const eventsList = await fetchEvents();
        if (calendar) {
          calendar.removeAllEvents();
          calendar.addEventSource(eventsList);
        }
        if (window.Ghostoast) {
          Ghostoast.success("Acara berhasil dihapus dari database.", "Acara Dihapus");
        }
      } catch (err) {
        console.error("Gagal menghapus acara:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menghapus acara.", "Terjadi Kesalahan");
        }
      }
    }

    // Attach to global window scope so HTML inline attributes always work
    window.fetchEvents = fetchEvents;
    window.showCalendarView = showCalendarView;
    window.showDashboardView = showDashboardView;
    window.showProjectDetailView = showProjectDetailView;
    window.updateSidebarNav = updateSidebarNav;
    window.openEventModal = openEventModal;
    window.closeEventModal = closeEventModal;
    window.updateMockupPreview = updateMockupPreview;
    window.setMockupTheme = setMockupTheme;
    window.saveEvent = saveEvent;
    window.deleteEvent = deleteEvent;
    
    function initCalendar(events) {
      const calendarEl = document.getElementById('calendar');
      if (calendarEl) {
        if (!calendar) {
          calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
              left: 'prev,today,next',
              center: 'title',
              right: 'dayGridMonth,timeGridWeek'
            },
            events: events,
            editable: true,
            selectable: true,
            eventDidMount: function(info) {
              const colorKey = info.event.extendedProps.color || 'blue';
              const gradient = themeGradientsMap[colorKey] || themeGradientsMap.blue;
              info.el.style.background = gradient;
              info.el.style.borderColor = 'transparent';
              info.el.style.color = '#ffffff';
            },
            dateClick: function(info) {
              openEventModal(info.dateStr);
            },
            eventClick: function(info) {
              const eventTitle = info.event.title || "Acara";
              const eventId = info.event.id;
              if (window.Ghostoast) {
                Ghostoast.confirm({
                  title: `Hapus Acara "${eventTitle}"?`,
                  message: `Acara ini akan dihapus secara permanen dari database.`,
                  confirmText: "Ya, Hapus Acara",
                  onConfirm: async () => {
                    await deleteEvent(eventId);
                  }
                });
              } else {
                deleteEvent(eventId);
              }
            },
            eventColor: '#2563eb',
            eventTextColor: '#ffffff',
            dayHeaderFormat: { weekday: 'short' },
            buttonText: {
              today: 'Hari Ini',
              month: 'Bulan',
              week: 'Minggu'
            },
          });
          calendar.render();
        } else {
          calendar.removeAllEvents();
          calendar.addEventSource(events);
        }
      }
    }

    async function saveProject(e) {
      e.preventDefault();
      const title = document.getElementById("projectTitle").value.trim();
      const category =
        document.getElementById("projectCategory").value.trim() || "Umum";
      const description = document.getElementById("projectDesc").value.trim();

      if (!title) return;

      try {
        const project = await api("/api/projects", {
          method: "POST",
          body: JSON.stringify({ title, category, description }),
        });
        projects.unshift(project);
        closeModal("projectModal");
        Ghostoast.success(
          `Projek "${title}" berhasil dibuat.`,
          "Projek Disimpan",
        );
        showProjectDetailView(project.id);
      } catch (err) {
        console.error("Gagal menyimpan projek:", err);
        Ghostoast.error("Gagal menyimpan projek baru.", "Terjadi Kesalahan");
      }
    }

    async function deleteProject(projectId, event) {
      if (event) event.stopPropagation();
      const project = projects.find((p) => p.id === projectId);
      const title = project
        ? `Hapus Projek "${project.title}"?`
        : "Hapus Projek Ini?";

      Ghostoast.confirm({
        title: title,
        message:
          "Projek ini beserta seluruh sub-task di dalamnya akan dihapus secara permanen.",
        confirmText: "Ya, Hapus Projek",
        onConfirm: async () => {
          try {
            await api(`/api/projects/${projectId}`, { method: "DELETE" });
            projects = projects.filter((p) => p.id !== projectId);
            Ghostoast.success(
              "Projek beserta seluruh tasknya telah dihapus.",
              "Projek Dihapus",
            );
            if (activeProjectId === projectId) {
              showDashboardView();
            } else {
              renderDashboard();
            }
          } catch (err) {
            console.error("Gagal menghapus projek:", err);
            Ghostoast.error("Gagal menghapus projek.", "Terjadi Kesalahan");
          }
        },
      });
    }

    function deleteActiveProject() {
      if (activeProjectId) {
        deleteProject(activeProjectId, null);
      }
    }

    async function saveTask(e) {
      e.preventDefault();
      if (!activeProjectId) return;

      const title = document.getElementById("taskTitle").value.trim();
      const description = document.getElementById("taskDesc").value.trim();
      if (!title) return;

      try {
        const task = await api(`/api/projects/${activeProjectId}/tasks`, {
          method: "POST",
          body: JSON.stringify({ title, description }),
        });
        const project = projects.find((p) => p.id === activeProjectId);
        if (project) project.tasks.push(task);
        closeModal("taskModal");
        Ghostoast.success(
          `Task "${title}" berhasil ditambahkan.`,
          "Task Dibuat",
        );
        renderDashboard();
      } catch (err) {
        console.error("Gagal menyimpan task:", err);
        Ghostoast.error("Gagal menyimpan task baru.", "Terjadi Kesalahan");
      }
    }

    async function toggleTask(projectId, taskId) {
      const project = projects.find((p) => p.id === projectId);
      if (!project) return;
      const task = project.tasks.find((t) => t.id === taskId);
      if (!task) return;

      try {
        const updated = await api(`/api/tasks/${taskId}`, {
          method: "PUT",
          body: JSON.stringify({ completed: !task.completed }),
        });
        task.completed = updated.completed;
        if (updated.completed) {
          Ghostoast.success(
            `Task "${task.title}" telah selesai! 🎉`,
            "Task Selesai",
          );
        } else {
          Ghostoast.info(
            `Status task "${task.title}" dikembalikan.`,
            "Status Diperbarui",
          );
        }
        renderDashboard();
      } catch (err) {
        console.error("Gagal mengupdate task:", err);
        Ghostoast.error("Gagal mengupdate status task.", "Terjadi Kesalahan");
      }
    }

    async function deleteTask(projectId, taskId) {
      const project = projects.find((p) => p.id === projectId);
      if (!project) return;
      const task = project.tasks.find((t) => t.id === taskId);
      const title = task ? `Hapus Task "${task.title}"?` : "Hapus Task Ini?";

      Ghostoast.confirm({
        title: title,
        message: "Task ini akan dihapus secara permanen dari daftar projek.",
        confirmText: "Ya, Hapus Task",
        onConfirm: async () => {
          try {
            await api(`/api/tasks/${taskId}`, { method: "DELETE" });
            project.tasks = project.tasks.filter((t) => t.id !== taskId);
            Ghostoast.info("Task berhasil dihapus.", "Task Dihapus");
            renderDashboard();
          } catch (err) {
            console.error("Gagal menghapus task:", err);
            Ghostoast.error("Gagal menghapus task.", "Terjadi Kesalahan");
          }
        },
      });
    }

    function setFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll(".filter-btn").forEach((btn) => {
        btn.classList.remove("bg-brand-600", "text-white");
        btn.classList.add("text-slate-600", "dark:text-slate-400");
      });
      const activeBtn = document.getElementById(`filter-${filter}`);
      if (activeBtn) {
        activeBtn.classList.add("bg-brand-600", "text-white");
        activeBtn.classList.remove("text-slate-600", "dark:text-slate-400");
      }
      renderDashboard();
    }

    function setTaskFilter(filter) {
      currentTaskFilter = filter;
      ["all", "active", "completed"].forEach((f) => {
        const btn = document.getElementById(`taskFilter-${f}`);
        if (!btn) return;
        if (f === filter) {
          btn.className =
            "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-brand-600 text-white shadow-sm";
        } else {
          btn.className =
            "px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all";
        }
      });
      renderDashboard();
    }

    function handleSearch() {
      searchQuery = document.getElementById("searchInput").value.toLowerCase();
      renderDashboard();
    }

    function updateStats() {
      const totalProjects = projects.length;
      let totalTasks = 0;
      let completedTasks = 0;
      let totalPercentageSum = 0;

      projects.forEach((p) => {
        const pTotal = p.tasks.length;
        const pCompleted = p.tasks.filter((t) => t.completed).length;
        totalTasks += pTotal;
        completedTasks += pCompleted;
        const pProgress = pTotal > 0 ? (pCompleted / pTotal) * 100 : 0;
        totalPercentageSum += pProgress;
      });

      const avgProgress =
        totalProjects > 0 ? Math.round(totalPercentageSum / totalProjects) : 0;

      document.getElementById("statTotalProjects").innerText = totalProjects;
      document.getElementById("statTotalTasks").innerText = totalTasks;
      document.getElementById("statCompletedTasks").innerText = completedTasks;
      document.getElementById("statAvgProgress").innerText = avgProgress + "%";
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderProjectsTableView() {
      const tbody = document.getElementById("projectsTableBody");
      const emptyState = document.getElementById("tableEmptyState");
      if (!tbody) return;
      tbody.innerHTML = "";

      let filtered = projects.filter((p) => {
        const tasks = p.tasks || [];
        const total = tasks.length;
        const completed = tasks.filter((t) => t.completed).length;
        const isCompleted = total > 0 && completed === total;

        if (currentFilter === "in-progress" && isCompleted) return false;
        if (currentFilter === "completed" && !isCompleted) return false;

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchTitle = (p.title || "").toLowerCase().includes(q);
          const matchCategory = (p.category || "").toLowerCase().includes(q);
          const matchDesc = (p.description || "").toLowerCase().includes(q);
          const matchTask = tasks.some(
            (t) =>
              (t.title || "").toLowerCase().includes(q) ||
              (t.description || "").toLowerCase().includes(q),
          );
          return matchTitle || matchCategory || matchDesc || matchTask;
        }

        return true;
      });

      const countLabel = document.getElementById("projectCountLabel");
      if (countLabel) countLabel.innerText = `Menampilkan ${filtered.length} Projek`;

      if (emptyState) {
        if (filtered.length === 0) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
        } else {
          emptyState.classList.add("hidden");
          emptyState.classList.remove("flex");
        }
      }

      filtered.forEach((p, index) => {
        const tasks = p.tasks || [];
        const totalTasks = tasks.length;
        const completedTasks = tasks.filter((t) => t.completed).length;
        const progress =
          totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
        const isCompleted = totalTasks > 0 && completedTasks === totalTasks;

        const tr = document.createElement("tr");
        const bgRow =
          index % 2 === 0
            ? "bg-slate-50/60 dark:bg-slate-900/60 hover:bg-slate-100 dark:hover:bg-slate-800/80"
            : "bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800/80";
        tr.className = `${bgRow} cursor-pointer transition-colors group`;
        tr.onclick = () => showProjectDetailView(p.id);

        tr.innerHTML = `
					<td class="px-6 py-4">
						<div class="font-bold text-slate-900 dark:text-white text-sm group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
							${escapeHtml(p.title)}
						</div>
						<div class="text-slate-500 dark:text-slate-400 text-xs line-clamp-1 mt-0.5 font-normal">
							${escapeHtml(p.description)}
						</div>
					</td>
					<td class="px-6 py-4 whitespace-nowrap">
						<span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
							${escapeHtml(p.category)}
						</span>
					</td>
					<td class="px-6 py-4 whitespace-nowrap font-medium text-slate-700 dark:text-slate-300">
						<i class="fa-regular fa-check-square mr-1 text-brand-500"></i> ${completedTasks} / ${totalTasks} Task
					</td>
					<td class="px-6 py-4 whitespace-nowrap">
						<div class="flex items-center gap-2">
							<div class="w-full bg-slate-100 dark:bg-slate-800 h-3 rounded-full overflow-hidden border border-slate-200 dark:border-slate-700">
								<div class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: ${progress}%"></div>
							</div>
							<span class="font-bold text-xs text-brand-700 dark:text-brand-400 w-9 text-right">${progress}%</span>
						</div>
					</td>
					<td class="px-6 py-4 whitespace-nowrap">
						${
              isCompleted
                ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
								<i class="fa-solid fa-check text-[9px]"></i> Selesai
							 </span>`
                : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
								<i class="fa-solid fa-spinner text-[9px] animate-spin"></i> Sedang Berjalan
							 </span>`
            }
					</td>
					<td class="px-6 py-4 whitespace-nowrap text-center">
						<div class="flex items-center justify-center gap-2">
							<button onclick="event.stopPropagation(); showProjectDetailView('${p.id}')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-slate-700 dark:text-slate-300 rounded-lg font-semibold transition-all border border-slate-200 dark:border-slate-700 flex items-center gap-1.5">
								<span>Buka Task</span>
								<i class="fa-solid fa-chevron-right text-[10px]"></i>
							</button>
							<button onclick="deleteProject('${p.id}', event)" title="Hapus Projek" class="text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-1.5 rounded-lg transition-colors">
								<i class="fa-regular fa-trash-can"></i>
							</button>
						</div>
					</td>
				`;

        tbody.appendChild(tr);
      });
    }

    async function quickAddTask(e) {
      e.preventDefault();
      if (!activeProjectId) return;
      const input = document.getElementById("quickTaskInput");
      const title = input ? input.value.trim() : "";
      if (!title) return;

      try {
        const task = await api(`/api/projects/${activeProjectId}/tasks`, {
          method: "POST",
          body: JSON.stringify({ title, description: "" }),
        });
        const project = projects.find((p) => p.id === activeProjectId);
        if (project) project.tasks.push(task);
        if (input) input.value = "";
        renderDashboard();
      } catch (err) {
        console.error("Gagal menyimpan task:", err);
        alert("Gagal menyimpan task.");
      }
    }

    function renderTaskDetailView() {
      const project = projects.find((p) => p.id === activeProjectId);
      if (!project) {
        showDashboardView();
        return;
      }

      const tasks = project.tasks || [];
      const totalTasks = tasks.length;
      const completedTasks = tasks.filter((t) => t.completed).length;
      const progress =
        totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
      const isCompleted = totalTasks > 0 && completedTasks === totalTasks;

      const titleElem = document.getElementById("detailProjectTitle");
      if (titleElem) titleElem.innerText = project.title;

      const breadcrumbElem = document.getElementById("breadcrumbProjectTitle");
      if (breadcrumbElem) breadcrumbElem.innerText = project.title;

      const categoryElem = document.getElementById("detailProjectCategory");
      if (categoryElem) categoryElem.innerText = project.category || "Umum";

      const descElem = document.getElementById("detailProjectDesc");
      if (descElem) descElem.innerText = project.description || "Tidak ada deskripsi projek.";

      const statusElem = document.getElementById("detailProjectStatus");
      if (statusElem) {
        if (isCompleted) {
          statusElem.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
          statusElem.innerText = "Selesai";
        } else {
          statusElem.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700";
          statusElem.innerText = "Sedang Berjalan";
        }
      }

      const progressTextElem = document.getElementById("detailProgressText");
      if (progressTextElem) progressTextElem.innerText = `${progress}% (${completedTasks}/${totalTasks})`;

      const progressBarElem = document.getElementById("detailProgressBar");
      if (progressBarElem) progressBarElem.style.width = `${progress}%`;

      const taskCountElem = document.getElementById("detailTaskCountLabel");
      if (taskCountElem) taskCountElem.innerText = `${completedTasks} dari ${totalTasks} task selesai`;

      // Render Task List
      const tasksContainer = document.getElementById("tasksListContainer");
      const emptyState = document.getElementById("tasksEmptyState");

      if (!tasksContainer) return;
      tasksContainer.innerHTML = "";

      let filteredTasks = tasks.filter((t) => {
        if (currentTaskFilter === "active" && t.completed) return false;
        if (currentTaskFilter === "completed" && !t.completed) return false;
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchTitle = (t.title || "").toLowerCase().includes(q);
          const matchDesc = (t.description || "").toLowerCase().includes(q);
          return matchTitle || matchDesc;
        }
        return true;
      });

      if (emptyState) {
        if (filteredTasks.length === 0) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
        } else {
          emptyState.classList.add("hidden");
          emptyState.classList.remove("flex");
        }
      }

      filteredTasks.forEach((t) => {
        const item = document.createElement("div");
        item.className =
          "p-4 sm:px-5 flex items-center justify-between gap-4 border-l-4 border-l-transparent hover:border-l-brand-600 dark:hover:border-l-brand-400 hover:bg-slate-100/70 dark:hover:bg-slate-800/80 transition-all group cursor-pointer";

        item.innerHTML = `
          <div class="flex items-start gap-3.5 flex-1 min-w-0">
            <input
              type="checkbox"
              ${t.completed ? "checked" : ""}
              onchange="toggleTask('${project.id}', '${t.id}')"
              class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-brand-600 focus:ring-brand-500 mt-0.5 cursor-pointer accent-brand-600 shrink-0"
            />
            <div class="flex-1 min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white ${t.completed ? "line-through text-slate-400 dark:text-slate-500 font-normal" : ""} leading-snug">
                ${escapeHtml(t.title)}
              </h4>
              ${t.description ? `<p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 font-normal">${escapeHtml(t.description)}</p>` : ""}
            </div>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full ${
              t.completed
                ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60"
                : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
            }">
              ${t.completed ? "Selesai" : "Belum Selesai"}
            </span>
            <button
              onclick="deleteTask('${project.id}', '${t.id}')"
              class="text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/50 p-2 rounded-xl transition-all"
              title="Hapus Task"
            >
              <i class="fa-regular fa-trash-can text-xs"></i>
            </button>
          </div>
        `;

        tasksContainer.appendChild(item);
      });
    }
  
  </script>
</Layout>
