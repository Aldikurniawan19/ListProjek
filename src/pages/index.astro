    async function saveTask(e) {
      e.preventDefault();
      if (!activeProjectId) return;

      const title = document.getElementById("taskTitle").value.trim();
      const description = document.getElementById("taskDesc").value.trim();
      const parentIdElem = document.getElementById("taskParentId");
      const parentId = parentIdElem ? parentIdElem.value.trim() : "";
      if (!title) return;

      const subTaskInputs = document.querySelectorAll('input[name="subTaskTitle"]');
      const subtasks = Array.from(subTaskInputs).map(i => i.value.trim()).filter(v => v.length > 0);

      if (window.showLoadingScreen) {
        window.showLoadingScreen('Menambahkan Task Baru', 'Menyimpan task beserta sub-task...');
      }

      try {
        const response = await api(`/api/projects/${activeProjectId}/tasks`, {
          method: "POST",
          body: JSON.stringify({ title, description, parentId: parentId || null, subtasks }),
        });

        const project = projects.find((p) => p.id === activeProjectId);
        if (project) {
          if (!project.tasks) project.tasks = [];
          if (response.createdTasks && Array.isArray(response.createdTasks)) {
            response.createdTasks.forEach(t => {
              if (!project.tasks.some(existing => existing.id === t.id)) {
                project.tasks.push(t);
              }
            });
          } else if (response.task) {
            project.tasks.push(response.task);
          } else {
            project.tasks.push(response);
          }

          if (parentId) {
            expandedTaskIds.add(parentId);
          }
          if (response.task && response.task.id && subtasks.length > 0) {
            expandedTaskIds.add(response.task.id);
          }
        }

        clearSubTaskRows();
        closeModal("taskModal");
        clearTaskParentId();

        try {
          renderDashboard();
        } catch (renderErr) {
          console.error("Gagal merender dashboard:", renderErr);
        }

        if (window.Ghostoast) {
          Ghostoast.success(
            `Task "${title}" ${subtasks.length > 0 ? `beserta ${subtasks.length} sub-task ` : ''}berhasil ditambahkan.`,
            "Task Dibuat",
          );
        }
      } catch (err) {
        console.error("Gagal menyimpan task:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menyimpan task baru.", "Terjadi Kesalahan");
        }
      } finally {
        if (window.hideLoadingScreen) {
          window.hideLoadingScreen();
        }
      }
    }

    async function toggleTask(projectId, taskId) {
      const project = projects.find((p) => p.id === projectId);
      if (!project) return;
      const task = project.tasks.find((t) => t.id === taskId);
      if (!task) return;

      try {
        const updated = await api(`/api/tasks/${taskId}`, {
          method: "PUT",
          body: JSON.stringify({ completed: !task.completed }),
        });
        task.completed = updated.completed;
        if (updated.completed) {
          Ghostoast.success(
            `Task "${task.title}" telah selesai! 🎉`,
            "Task Selesai",
          );
        } else {
          Ghostoast.info(
            `Status task "${task.title}" dikembalikan.`,
            "Status Diperbarui",
          );
        }
        renderDashboard();
      } catch (err) {
        console.error("Gagal mengupdate task:", err);
        Ghostoast.error("Gagal mengupdate status task.", "Terjadi Kesalahan");
      }
    }

    function getDescendantTaskIds(allTasks, parentId) {
      let ids = [];
      const children = (allTasks || []).filter((t) => t.parentId === parentId);
      children.forEach((child) => {
        ids.push(child.id);
        ids = ids.concat(getDescendantTaskIds(allTasks, child.id));
      });
      return ids;
    }

    async function deleteTask(projectId, taskId) {
      const project = projects.find((p) => p.id === projectId);
      if (!project) return;
      const task = project.tasks.find((t) => t.id === taskId);
      const title = task ? `Hapus Task "${task.title}"?` : "Hapus Task Ini?";

      Ghostoast.confirm({
        title: title,
        message: "Task ini beserta seluruh sub-task di dalamnya akan dihapus secara permanen.",
        confirmText: "Ya, Hapus Task",
        onConfirm: async () => {
          try {
            await api(`/api/tasks/${taskId}`, { method: "DELETE" });
            const toDelete = new Set([taskId, ...getDescendantTaskIds(project.tasks, taskId)]);
            project.tasks = (project.tasks || []).filter((t) => !toDelete.has(t.id));
            Ghostoast.info("Task berhasil dihapus.", "Task Dihapus");
            renderDashboard();
          } catch (err) {
            console.error("Gagal menghapus task:", err);
            Ghostoast.error("Gagal menghapus task.", "Terjadi Kesalahan");
          }
        },
      });
    }

