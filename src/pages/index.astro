    function initCalendar(events) {
      const calendarEl = document.getElementById('calendar');
      if (calendarEl) {
        if (!calendar) {
          calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
              left: 'prev,today,next',
              center: 'title',
              right: 'dayGridMonth,timeGridWeek'
            },
            events: events,
            editable: true,
            selectable: true,
            eventDidMount: function(info) {
              const colorKey = info.event.extendedProps.color || 'blue';
              const gradient = themeGradientsMap[colorKey] || themeGradientsMap.blue;
              info.el.style.background = gradient;
              info.el.style.borderColor = 'transparent';
              info.el.style.color = '#ffffff';
            },
            dateClick: function(info) {
              openEventModal(info.dateStr);
            },
            eventClick: function(info) {
              const eventTitle = info.event.title || "Acara";
              const eventId = info.event.id;
              if (window.Ghostoast) {
                Ghostoast.confirm({
                  title: `Hapus Acara "${eventTitle}"?`,
                  message: `Acara ini akan dihapus secara permanen dari database.`,
                  confirmText: "Ya, Hapus Acara",
                  onConfirm: async () => {
                    await deleteEvent(eventId);
                  }
                });
              } else {
                deleteEvent(eventId);
              }
            },
            eventColor: '#2563eb',
            eventTextColor: '#ffffff',
            dayHeaderFormat: { weekday: 'short' },
            buttonText: {
              today: 'Hari Ini',
              month: 'Bulan',
              week: 'Minggu'
            },
          });
          calendar.render();
        } else {
          calendar.removeAllEvents();
          calendar.addEventSource(events);
        }
      }
    }

    async function saveProject(e) {
      e.preventDefault();
      const title = document.getElementById("projectTitle").value.trim();
      const category =
        document.getElementById("projectCategory").value.trim() || "Umum";
      const description = document.getElementById("projectDesc").value.trim();

      if (!title) return;

      if (window.showLoadingScreen) {
        window.showLoadingScreen('Membuat Projek Baru', 'Menyiapkan workspace projek Anda...');
      }

      try {
        const project = await api("/api/projects", {
          method: "POST",
          body: JSON.stringify({ title, category, description }),
        });
        if (!project.tasks) project.tasks = [];
        projects.unshift(project);
        closeModal("projectModal");
        try {
          showProjectDetailView(project.id);
        } catch (renderErr) {
          console.error("Gagal merender detail projek:", renderErr);
        }
        if (window.Ghostoast) {
          Ghostoast.success(
            `Projek "${title}" berhasil dibuat.`,
            "Projek Disimpan",
          );
        }
      } catch (err) {
        console.error("Gagal menyimpan projek:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menyimpan projek baru.", "Terjadi Kesalahan");
        }
      } finally {
        if (window.hideLoadingScreen) {
          window.hideLoadingScreen();
        }
      }
    }

    async function saveDeployedWeb(e) {
      e.preventDefault();
      const title = document.getElementById("deployedTitle").value.trim();
      let liveUrl = document.getElementById("deployedLiveUrl").value.trim();
      const platform = document.getElementById("deployedPlatform").value;
      const description = document.getElementById("deployedDesc").value.trim();

      if (!title || !liveUrl) return;

      if (!/^https?:\/\//i.test(liveUrl)) {
        liveUrl = `https://${liveUrl}`;
      }

      if (window.showLoadingScreen) {
        window.showLoadingScreen('Menyimpan Web Online', 'Menghubungkan live URL web...');
      }

      try {
        const category = `Web Live (${platform})`;
        const project = await api("/api/projects", {
          method: "POST",
          body: JSON.stringify({ title, category, description, liveUrl }),
        });
        if (!project.tasks) project.tasks = [];
        projects.unshift(project);
        closeModal("deployedWebModal");
        if (window.Ghostoast) {
          Ghostoast.success(
            `Website "${title}" berhasil ditambahkan ke daftar online.`,
            "Web Online Tersimpan",
          );
        }
        showDeployedView();
      } catch (err) {
        console.error("Gagal menyimpan web online:", err);
        if (window.Ghostoast) {
          Ghostoast.error("Gagal menyimpan web online baru.", "Terjadi Kesalahan");
        }
      } finally {
        if (window.hideLoadingScreen) {
          window.hideLoadingScreen();
        }
      }
    }

