    function updateStats() {
      const internalProjects = projects.filter(p => !p.liveUrl && (!p.category || !p.category.includes("Web Live")));
      const totalProjects = internalProjects.length;
      let totalTasks = 0;
      let completedTasks = 0;
      let totalPercentageSum = 0;

      internalProjects.forEach((p) => {
        const tasks = p.tasks || [];
        const pTotal = tasks.length;
        const pCompleted = tasks.filter((t) => t.completed).length;
        totalTasks += pTotal;
        completedTasks += pCompleted;
        const pProgress = pTotal > 0 ? (pCompleted / pTotal) * 100 : 0;
        totalPercentageSum += pProgress;
      });

      const avgProgress =
        totalProjects > 0 ? Math.round(totalPercentageSum / totalProjects) : 0;

      document.getElementById("statTotalProjects").innerText = totalProjects;
      document.getElementById("statTotalTasks").innerText = totalTasks;
      document.getElementById("statCompletedTasks").innerText = completedTasks;
      document.getElementById("statAvgProgress").innerText = avgProgress + "%";
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatExternalUrl(url) {
      if (!url || url === '#') return '#';
      const trimmed = String(url).trim();
      if (!trimmed) return '#';
      if (/^https?:\/\//i.test(trimmed)) {
        return trimmed;
      }
      return `https://${trimmed}`;
    }

